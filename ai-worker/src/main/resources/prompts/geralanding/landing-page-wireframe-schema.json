{
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "pageGoal": { "type": "string" },
    "variantLayoutId": {
      "type": "string",
      "enum": ["form-first", "proof-first", "story-first"]
    },
    "messageMatchSummary": { "type": "string" },
    "mobilePriorityNotes": { "type": "string" },
    "ctaPlacementNotes": { "type": "string" },
    "formPlacementNotes": { "type": "string" },
    "sectionOrder": {
      "type": "array",
      "minItems": 4,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "sectionId": { "type": "string" },
          "sectionName": { "type": "string" },
          "objective": { "type": "string" },
          "contentType": {
            "type": "string",
            "enum": ["hero", "form", "split", "proof", "timeline", "faq", "cta"]
          },
          "copySource": { "type": "string" },
          "uiNotes": { "type": "string" },
          "messageMatchDependency": { "type": "string" },
          "sectionDependsOn": {
            "type": "array",
            "items": { "type": "string" }
          },
          "mobilePriorityScore": { "type": "integer", "minimum": 1, "maximum": 10 },
          "dropOffRisk": { "type": "string", "enum": ["baixo", "medio", "alto"] },
          "surfaceSpec": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "surfaceToken": { "type": "string" },
              "notes": { "type": "string" }
            },
            "required": ["surfaceToken", "notes"]
          },
          "ctaSlot": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "hasCta": { "type": "boolean" },
              "ctaLabel": { "type": "string" },
              "ctaVariant": { "type": "string" },
              "matchAdCta": { "type": "string" },
              "notes": { "type": "string" }
            },
            "required": ["hasCta", "ctaLabel", "ctaVariant", "matchAdCta", "notes"]
          }
        },
        "required": [
          "sectionId",
          "sectionName",
          "objective",
          "contentType",
          "copySource",
          "uiNotes",
          "messageMatchDependency",
          "sectionDependsOn",
          "mobilePriorityScore",
          "dropOffRisk",
          "surfaceSpec",
          "ctaSlot"
        ]
      }
    },
    "consistencyChecks": {
      "type": "array",
      "minItems": 2,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "check": { "type": "string" },
          "status": { "type": "string", "enum": ["PASS", "WARN", "FAIL"] },
          "details": { "type": "string" }
        },
        "required": ["check", "status", "details"]
      }
    }
  },
  "required": [
    "pageGoal",
    "variantLayoutId",
    "messageMatchSummary",
    "mobilePriorityNotes",
    "ctaPlacementNotes",
    "formPlacementNotes",
    "sectionOrder",
    "consistencyChecks"
  ]
}
