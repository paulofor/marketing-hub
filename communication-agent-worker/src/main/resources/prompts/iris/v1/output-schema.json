{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "contractVersion",
    "executionStatus",
    "sourceReference",
    "activityId",
    "outputType",
    "strategicContractReference",
    "alternatives",
    "chosenAlternative",
    "functionalOutput",
    "evidenceGaps",
    "nextHandoff",
    "guardrails",
    "expectedMetric",
    "continueCriteria",
    "adjustCriteria",
    "stopCriteria"
  ],
  "properties": {
    "contractVersion": {
      "type": "string",
      "const": "IRIS_COMMUNICATION_V1"
    },
    "executionStatus": {
      "type": "string",
      "enum": [
        "COMPLETED",
        "READY_FOR_RENDER",
        "BLOCKED"
      ]
    },
    "sourceReference": {
      "type": "string",
      "minLength": 1
    },
    "activityId": {
      "type": "string",
      "minLength": 1
    },
    "outputType": {
      "type": "string",
      "enum": [
        "COMMUNICATION_PACKAGE",
        "NON_AUDIOVISUAL_PACKAGE",
        "LANDING_EVIDENCE",
        "LANDING_STRATEGY",
        "LANDING_COMPOSITION",
        "LANDING_HTML"
      ]
    },
    "strategicContractReference": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "contractVersion",
        "contentHash",
        "preserved"
      ],
      "properties": {
        "contractVersion": {
          "type": "string",
          "minLength": 1
        },
        "contentHash": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "preserved": {
          "type": "boolean"
        }
      }
    },
    "alternatives": {
      "type": "array",
      "minItems": 3,
      "maxItems": 3,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "name",
          "benefit",
          "risk",
          "effort",
          "adherence"
        ],
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1
          },
          "benefit": {
            "type": "string",
            "minLength": 1
          },
          "risk": {
            "type": "string",
            "minLength": 1
          },
          "effort": {
            "type": "string",
            "minLength": 1
          },
          "adherence": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "chosenAlternative": {
      "type": "string",
      "minLength": 1
    },
    "functionalOutput": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "messageStrategy",
        "copy",
        "channelBriefings",
        "staticAssets",
        "emailSequence",
        "evidenceSelection",
        "conversionArchitecture",
        "visualComposition",
        "landingHtml",
        "audiovisualBrief",
        "persuasionEvidence"
      ],
      "properties": {
        "messageStrategy": {
          "type": "string"
        },
        "copy": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "primaryText",
            "headline",
            "description",
            "ctaText"
          ],
          "properties": {
            "primaryText": {
              "type": "string"
            },
            "headline": {
              "type": "string"
            },
            "description": {
              "type": "string"
            },
            "ctaText": {
              "type": "string"
            }
          }
        },
        "channelBriefings": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "staticAssets": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "type",
              "format",
              "content",
              "proofReference",
              "renderSpec"
            ],
            "properties": {
              "type": {
                "type": "string",
                "minLength": 1
              },
              "format": {
                "type": "string",
                "minLength": 1
              },
              "content": {
                "type": "string",
                "minLength": 1
              },
              "proofReference": {
                "type": "string",
                "minLength": 1
              },
              "renderSpec": {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "templateVersion": {
                    "type": "string",
                    "enum": [
                      "PROOF_CARD_V1",
                      "EDITORIAL_CARD_V1"
                    ]
                  },
                  "sourceArtifactId": {
                    "type": "integer",
                    "minimum": 1
                  },
                  "sourceSha256": {
                    "type": "string",
                    "pattern": "^[0-9a-f]{64}$"
                  },
                  "crop": {
                    "type": "object",
                    "additionalProperties": false,
                    "properties": {
                      "x": {
                        "type": "integer",
                        "minimum": 0
                      },
                      "y": {
                        "type": "integer",
                        "minimum": 0
                      },
                      "width": {
                        "type": "integer",
                        "minimum": 100
                      },
                      "height": {
                        "type": "integer",
                        "minimum": 100
                      }
                    },
                    "required": [
                      "x",
                      "y",
                      "width",
                      "height"
                    ]
                  },
                  "brandLabel": {
                    "type": "string",
                    "minLength": 1
                  },
                  "eyebrow": {
                    "type": "string",
                    "minLength": 1
                  },
                  "headline": {
                    "type": "string",
                    "minLength": 1
                  },
                  "body": {
                    "type": "string",
                    "minLength": 1
                  },
                  "ctaText": {
                    "type": "string",
                    "minLength": 1
                  },
                  "footer": {
                    "type": "string",
                    "minLength": 1
                  },
                  "backgroundColor": {
                    "type": "string",
                    "minLength": 1
                  },
                  "accentColor": {
                    "type": "string",
                    "minLength": 1
                  },
                  "illustration": {
                    "type": [
                      "object",
                      "null"
                    ],
                    "additionalProperties": false,
                    "properties": {
                      "jobId": {
                        "type": "string",
                        "minLength": 1
                      },
                      "sha256": {
                        "type": "string",
                        "pattern": "^[0-9a-f]{64}$"
                      },
                      "role": {
                        "type": "string",
                        "enum": [
                          "GENERATED_ILLUSTRATION"
                        ]
                      },
                      "crop": {
                        "type": "object",
                        "additionalProperties": false,
                        "properties": {
                          "x": {
                            "type": "integer",
                            "minimum": 0
                          },
                          "y": {
                            "type": "integer",
                            "minimum": 0
                          },
                          "width": {
                            "type": "integer",
                            "minimum": 100
                          },
                          "height": {
                            "type": "integer",
                            "minimum": 100
                          }
                        },
                        "required": [
                          "x",
                          "y",
                          "width",
                          "height"
                        ]
                      }
                    },
                    "required": [
                      "jobId",
                      "sha256",
                      "role",
                      "crop"
                    ]
                  }
                },
                "required": [
                  "templateVersion",
                  "sourceArtifactId",
                  "sourceSha256",
                  "crop",
                  "brandLabel",
                  "eyebrow",
                  "headline",
                  "body",
                  "ctaText",
                  "footer",
                  "backgroundColor",
                  "accentColor",
                  "illustration"
                ]
              }
            }
          }
        },
        "emailSequence": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "evidenceSelection": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "reference",
              "version",
              "purpose"
            ],
            "properties": {
              "reference": {
                "type": "string",
                "minLength": 1
              },
              "version": {
                "type": "string",
                "minLength": 1
              },
              "purpose": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        },
        "conversionArchitecture": {
          "type": "string"
        },
        "visualComposition": {
          "type": "string"
        },
        "landingHtml": {
          "type": [
            "string",
            "null"
          ]
        },
        "audiovisualBrief": {
          "type": [
            "string",
            "null"
          ]
        },
        "persuasionEvidence": {
          "type": [
            "object",
            "null"
          ],
          "additionalProperties": false,
          "required": [
            "contractVersion",
            "criteria",
            "emotionalConnection"
          ],
          "properties": {
            "contractVersion": {
              "type": "string",
              "const": "COMMERCIAL_PERSUASION_EVIDENCE_V2"
            },
            "criteria": {
              "type": "array",
              "minItems": 5,
              "maxItems": 5,
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "criterion",
                  "decision",
                  "customerMessage",
                  "sourcePointer",
                  "sourceQuote",
                  "metric",
                  "limitation"
                ],
                "properties": {
                  "criterion": {
                    "type": "string",
                    "enum": [
                      "RECOGNIZED_DESIRE",
                      "EASY_FIRST_STEP",
                      "VALUE_BEFORE_COMMITMENT",
                      "PAID_INCREMENT",
                      "REPEAT_WITH_MARGIN"
                    ]
                  },
                  "decision": {
                    "type": "string",
                    "minLength": 1
                  },
                  "customerMessage": {
                    "type": [
                      "string",
                      "null"
                    ]
                  },
                  "sourcePointer": {
                    "type": "string",
                    "minLength": 1
                  },
                  "sourceQuote": {
                    "type": "string",
                    "minLength": 1
                  },
                  "metric": {
                    "type": "string",
                    "enum": [
                      "AD_CLICK_THROUGH_RATE",
                      "QUALIFIED_VISIT_RATE",
                      "SAMPLE_VIEW_RATE",
                      "FIRST_VALUE_COMPLETION_RATE",
                      "SAMPLE_TO_CHECKOUT_RATE",
                      "NET_PURCHASE_CONVERSION_RATE",
                      "NET_CONTRIBUTION_AFTER_ACQUISITION"
                    ]
                  },
                  "limitation": {
                    "type": "string",
                    "minLength": 1
                  }
                }
              }
            },
            "emotionalConnection": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "everydaySituation",
                "beliefHypothesis",
                "recognizedDesire",
                "emotionalPayoff",
                "reframe",
                "directionSourcePointer",
                "directionSourceQuote",
                "customerOpening",
                "proofBridge",
                "easyNextStep",
                "limitation"
              ],
              "properties": {
                "everydaySituation": {
                  "type": "string",
                  "minLength": 1
                },
                "beliefHypothesis": {
                  "type": "string",
                  "minLength": 1
                },
                "recognizedDesire": {
                  "type": "string",
                  "minLength": 1
                },
                "emotionalPayoff": {
                  "type": "string",
                  "minLength": 1
                },
                "reframe": {
                  "type": "string",
                  "minLength": 1
                },
                "directionSourcePointer": {
                  "type": "string",
                  "minLength": 1
                },
                "directionSourceQuote": {
                  "type": "string",
                  "minLength": 1
                },
                "customerOpening": {
                  "type": "string",
                  "minLength": 1
                },
                "proofBridge": {
                  "type": "string",
                  "minLength": 1
                },
                "easyNextStep": {
                  "type": "string",
                  "minLength": 1
                },
                "limitation": {
                  "type": "string",
                  "minLength": 1
                }
              }
            }
          }
        }
      }
    },
    "evidenceGaps": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "nextHandoff": {
      "type": "string",
      "enum": [
        "BACKEND",
        "APOLO",
        "PSIQUE",
        "TEMIS",
        "BLOCKED"
      ]
    },
    "guardrails": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "strategyPreserved",
        "productPreserved",
        "pricePreserved",
        "noFabricatedProof",
        "noPublication",
        "noExternalSpend"
      ],
      "properties": {
        "strategyPreserved": {
          "type": "boolean"
        },
        "productPreserved": {
          "type": "boolean"
        },
        "pricePreserved": {
          "type": "boolean"
        },
        "noFabricatedProof": {
          "type": "boolean"
        },
        "noPublication": {
          "type": "boolean"
        },
        "noExternalSpend": {
          "type": "boolean"
        }
      }
    },
    "expectedMetric": {
      "type": "string",
      "minLength": 1
    },
    "continueCriteria": {
      "type": "string",
      "minLength": 1
    },
    "adjustCriteria": {
      "type": "string",
      "minLength": 1
    },
    "stopCriteria": {
      "type": "string",
      "minLength": 1
    }
  }
}
