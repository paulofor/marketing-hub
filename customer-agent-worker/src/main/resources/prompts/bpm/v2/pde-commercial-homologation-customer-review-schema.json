{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "decision",
    "customerPerspective",
    "valueScore",
    "behavioralResponse",
    "purchaseEmotion",
    "visualAudit",
    "gateChecks",
    "evidence",
    "limitations",
    "requiredChanges"
  ],
  "properties": {
    "decision": { "type": "string", "enum": ["APPROVED", "ADJUST", "BLOCKED"] },
    "customerPerspective": {
      "type": "string",
      "minLength": 20,
      "maxLength": 1800
    },
    "valueScore": { "type": "integer", "minimum": 0, "maximum": 100 },
    "behavioralResponse": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "firstImpulse",
        "dominantEmotion",
        "safeNovelty",
        "belongingAdmirationLove",
        "effortPerception",
        "sensoryExperience",
        "trustBoundary"
      ],
      "properties": {
        "firstImpulse": { "type": "string", "minLength": 10, "maxLength": 700 },
        "dominantEmotion": {
          "type": "string",
          "minLength": 3,
          "maxLength": 200
        },
        "safeNovelty": { "type": "string", "minLength": 10, "maxLength": 700 },
        "belongingAdmirationLove": {
          "type": "string",
          "minLength": 10,
          "maxLength": 700
        },
        "effortPerception": {
          "type": "string",
          "minLength": 10,
          "maxLength": 700
        },
        "sensoryExperience": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "evidenceAvailable",
            "availableModalities",
            "pleasureByModality",
            "processingFluency",
            "sensoryCongruence",
            "overloadRisk",
            "embodiedAnticipation",
            "dominantCue",
            "evidenceBoundary"
          ],
          "properties": {
            "evidenceAvailable": { "type": "boolean" },
            "availableModalities": {
              "type": "array",
              "items": {
                "type": "string",
                "enum": ["VISUAL", "AUDIO", "MOTION", "TACTILE_IMAGERY"]
              }
            },
            "pleasureByModality": {
              "type": "array",
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": ["modality", "pleasureScore", "evidence"],
                "properties": {
                  "modality": {
                    "type": "string",
                    "enum": ["VISUAL", "AUDIO", "MOTION", "TACTILE_IMAGERY"]
                  },
                  "pleasureScore": {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 5
                  },
                  "evidence": { "type": "string" }
                }
              }
            },
            "processingFluency": {
              "type": "integer",
              "minimum": 0,
              "maximum": 5
            },
            "sensoryCongruence": {
              "type": "integer",
              "minimum": 0,
              "maximum": 5
            },
            "overloadRisk": { "type": "integer", "minimum": 0, "maximum": 5 },
            "embodiedAnticipation": { "type": "string" },
            "dominantCue": { "type": "string" },
            "evidenceBoundary": { "type": "string" }
          }
        },
        "trustBoundary": { "type": "string", "minLength": 10, "maxLength": 700 }
      }
    },
    "purchaseEmotion": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "acquisitionExpectation",
        "acquisitionAnxiety",
        "expectedPostDeliveryFeeling",
        "emotionalTension",
        "evidenceBoundary"
      ],
      "properties": {
        "acquisitionExpectation": {
          "type": "string",
          "minLength": 10,
          "maxLength": 700
        },
        "acquisitionAnxiety": {
          "type": "string",
          "minLength": 10,
          "maxLength": 700
        },
        "expectedPostDeliveryFeeling": {
          "type": "string",
          "minLength": 10,
          "maxLength": 700
        },
        "emotionalTension": {
          "type": "string",
          "minLength": 10,
          "maxLength": 700
        },
        "evidenceBoundary": {
          "type": "string",
          "minLength": 10,
          "maxLength": 700
        }
      }
    },
    "visualAudit": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "captureSessionId",
        "mobileFirst",
        "fullPageEvidenceIds",
        "fullPageContinuity",
        "overallAestheticAssessment",
        "foldAnalyses"
      ],
      "properties": {
        "captureSessionId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 80
        },
        "mobileFirst": { "const": true },
        "fullPageEvidenceIds": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "integer", "minimum": 1 }
        },
        "fullPageContinuity": {
          "type": "string",
          "minLength": 10,
          "maxLength": 1000
        },
        "overallAestheticAssessment": {
          "type": "string",
          "minLength": 10,
          "maxLength": 1000
        },
        "foldAnalyses": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "artifactId",
              "deviceProfile",
              "pageNumber",
              "foldNumber",
              "aestheticAssessment",
              "visualHierarchy",
              "legibility",
              "emotionEvoked",
              "ctaVisibility"
            ],
            "properties": {
              "artifactId": { "type": "integer", "minimum": 1 },
              "deviceProfile": { "const": "IPHONE_15_PRO" },
              "pageNumber": { "type": "integer", "minimum": 1 },
              "foldNumber": { "type": "integer", "minimum": 1 },
              "aestheticAssessment": {
                "type": "string",
                "minLength": 3,
                "maxLength": 700
              },
              "visualHierarchy": {
                "type": "string",
                "minLength": 3,
                "maxLength": 700
              },
              "legibility": {
                "type": "string",
                "minLength": 3,
                "maxLength": 700
              },
              "emotionEvoked": {
                "type": "string",
                "minLength": 3,
                "maxLength": 700
              },
              "ctaVisibility": {
                "type": "string",
                "minLength": 3,
                "maxLength": 700
              }
            }
          }
        }
      }
    },
    "gateChecks": {
      "type": "array",
      "minItems": 8,
      "maxItems": 20,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["gate", "status", "customerEvidence", "remainingRisk"],
        "properties": {
          "gate": { "type": "string", "minLength": 3, "maxLength": 120 },
          "status": { "type": "string", "enum": ["PASS", "ADJUST", "BLOCK"] },
          "customerEvidence": {
            "type": "string",
            "minLength": 10,
            "maxLength": 700
          },
          "remainingRisk": {
            "type": "string",
            "minLength": 3,
            "maxLength": 500
          }
        }
      }
    },
    "evidence": {
      "type": "array",
      "minItems": 6,
      "maxItems": 24,
      "items": { "type": "string", "minLength": 10, "maxLength": 700 }
    },
    "limitations": {
      "type": "array",
      "minItems": 1,
      "maxItems": 12,
      "items": { "type": "string", "minLength": 10, "maxLength": 700 }
    },
    "requiredChanges": {
      "type": "array",
      "maxItems": 16,
      "items": { "type": "string", "minLength": 5, "maxLength": 700 }
    }
  }
}
