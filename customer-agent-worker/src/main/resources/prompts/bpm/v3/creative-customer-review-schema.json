                    "maximum": 5
                  },
                  "evidence": {
                    "type": "string"
                  }
                }
              }
            },
            "processingFluency": {
              "type": "integer",
              "minimum": 0,
              "maximum": 5
            },
            "sensoryCongruence": {
              "type": "integer",
              "minimum": 0,
              "maximum": 5
            },
            "overloadRisk": {
              "type": "integer",
              "minimum": 0,
              "maximum": 5
