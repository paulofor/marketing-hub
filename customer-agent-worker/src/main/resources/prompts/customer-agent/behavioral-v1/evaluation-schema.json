{
  "type": "object",
  "additionalProperties": false,
  "required": ["decision", "assessment", "initialState", "competingGoals", "mentalTransitions", "actionProbabilities", "memoryRecall", "hypotheses", "baselineComparison", "sources"],
  "properties": {
    "decision": {"type": "string", "enum": ["APROVAR_TESTE", "AJUSTAR", "REPROVAR"]},
    "assessment": {"type": "string"},
    "initialState": {
      "type": "object",
      "additionalProperties": false,
      "required": ["attention", "urgency", "categoryFamiliarity", "currentNeed", "initialTrust", "financialConstraint", "socialContext", "evidenceBoundary"],
      "properties": {
        "attention": {"type": "integer", "minimum": 0, "maximum": 5},
        "urgency": {"type": "integer", "minimum": 0, "maximum": 5},
        "categoryFamiliarity": {"type": "integer", "minimum": 0, "maximum": 5},
        "currentNeed": {"type": "integer", "minimum": 0, "maximum": 5},
        "initialTrust": {"type": "integer", "minimum": 0, "maximum": 5},
        "financialConstraint": {"type": "integer", "minimum": 0, "maximum": 5},
        "socialContext": {"type": "string"},
        "evidenceBoundary": {"type": "string"}
      }
    },
    "competingGoals": {"type": "array", "items": {"type": "object", "additionalProperties": false, "required": ["goal", "weight", "evidence"], "properties": {"goal": {"type": "string"}, "weight": {"type": "integer", "minimum": 0, "maximum": 5}, "evidence": {"type": "string"}}}},
    "mentalTransitions": {"type": "array", "items": {"type": "object", "additionalProperties": false, "required": ["from", "to", "trigger", "friction", "probability"], "properties": {"from": {"type": "string"}, "to": {"type": "string"}, "trigger": {"type": "string"}, "friction": {"type": "string"}, "probability": {"type": "integer", "minimum": 0, "maximum": 100}}}},
    "actionProbabilities": {
      "type": "object",
      "additionalProperties": false,
      "required": ["ignore", "explore", "startAction", "abandon", "checkout", "purchase"],
      "properties": {
        "ignore": {"type": "integer", "minimum": 0, "maximum": 100},
        "explore": {"type": "integer", "minimum": 0, "maximum": 100},
        "startAction": {"type": "integer", "minimum": 0, "maximum": 100},
        "abandon": {"type": "integer", "minimum": 0, "maximum": 100},
        "checkout": {"type": "integer", "minimum": 0, "maximum": 100},
        "purchase": {"type": "integer", "minimum": 0, "maximum": 100}
      }
    },
    "memoryRecall": {"type": "object", "additionalProperties": false, "required": ["remembered", "confused", "forgotten"], "properties": {"remembered": {"type": "array", "items": {"type": "string"}}, "confused": {"type": "array", "items": {"type": "string"}}, "forgotten": {"type": "array", "items": {"type": "string"}}}},
    "hypotheses": {"type": "array", "items": {"type": "object", "additionalProperties": false, "required": ["statement", "evidence", "confidence"], "properties": {"statement": {"type": "string"}, "evidence": {"type": "string"}, "confidence": {"type": "string", "enum": ["LOW", "MEDIUM", "HIGH"]}}}},
    "baselineComparison": {"type": "object", "additionalProperties": false, "required": ["baselineDecision", "agreements", "divergences", "predictiveGainHypothesis", "verdict"], "properties": {"baselineDecision": {"type": "string"}, "agreements": {"type": "array", "items": {"type": "string"}}, "divergences": {"type": "array", "items": {"type": "string"}}, "predictiveGainHypothesis": {"type": "string"}, "verdict": {"type": "string", "enum": ["CONTINUE_TESTING", "ADJUST_MODEL", "NO_EXPECTED_GAIN"]}}},
    "sources": {"type": "array", "items": {"type": "object", "additionalProperties": false, "required": ["url", "title", "accessedAt", "collectionMethod", "learning"], "properties": {"url": {"type": "string"}, "title": {"type": "string"}, "accessedAt": {"type": "string"}, "collectionMethod": {"type": "string", "enum": ["WEB_SEARCH", "PLAYWRIGHT", "PUBLIC_API"]}, "learning": {"type": "string"}}}}
  }
}
