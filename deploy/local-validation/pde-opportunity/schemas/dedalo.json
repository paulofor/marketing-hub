{
  "type": "object",
  "additionalProperties": false,
  "required": ["decision", "comparison", "chosenOpportunity", "rejectedReasons", "missingEvidence", "rationale"],
  "properties": {
    "decision": { "type": "string", "enum": ["APPROVE", "RESEARCH_MORE", "REJECT"] },
    "comparison": {
      "type": "array",
      "minItems": 3,
      "maxItems": 3,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "audienceModel", "consumerMoment", "instagramHook", "mobileValueMomentMinutes", "operationalDependencies", "benefit", "risk", "evidenceQuality", "revenuePath", "formats", "chosenFormat", "pdeMechanism", "evidenceScore", "purchaseIntentScore", "painValueScore", "pdeFitScore", "differentiationScore", "distributionScore", "economicsScalabilityScore", "riskSafetyScore", "totalScore"],
        "properties": {
          "name": { "type": "string" },
          "audienceModel": { "type": "string", "enum": ["B2C", "B2B"] },
          "consumerMoment": { "type": "string" },
          "instagramHook": { "type": "string" },
          "mobileValueMomentMinutes": { "type": "integer", "minimum": 1, "maximum": 120 },
          "operationalDependencies": { "type": "array", "items": { "type": "string" } },
          "benefit": { "type": "string" },
          "risk": { "type": "string" },
          "evidenceQuality": { "type": "string" },
          "revenuePath": { "type": "string" },
          "formats": {
            "type": "array",
            "minItems": 3,
            "maxItems": 3,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["name", "benefit", "adoptionEffort", "variableCostRisk", "scalePotential", "rejectionReason"],
              "properties": {
                "name": { "type": "string", "enum": ["STATIC_MATERIAL", "GUIDED_WEBAPP", "ASSISTED_EXECUTION"] },
                "benefit": { "type": "string" },
                "adoptionEffort": { "type": "string", "enum": ["LOW", "MEDIUM", "HIGH"] },
                "variableCostRisk": { "type": "string", "enum": ["LOW", "MEDIUM", "HIGH"] },
                "scalePotential": { "type": "string", "enum": ["LOW", "MEDIUM", "HIGH"] },
                "rejectionReason": { "type": "string" }
              }
            }
          },
          "chosenFormat": { "type": "string", "enum": ["STATIC_MATERIAL", "GUIDED_WEBAPP", "ASSISTED_EXECUTION"] },
          "pdeMechanism": { "type": "string" },
          "evidenceScore": { "type": "integer", "minimum": 0, "maximum": 20 },
          "purchaseIntentScore": { "type": "integer", "minimum": 0, "maximum": 20 },
          "painValueScore": { "type": "integer", "minimum": 0, "maximum": 15 },
          "pdeFitScore": { "type": "integer", "minimum": 0, "maximum": 15 },
          "differentiationScore": { "type": "integer", "minimum": 0, "maximum": 10 },
          "distributionScore": { "type": "integer", "minimum": 0, "maximum": 10 },
          "economicsScalabilityScore": { "type": "integer", "minimum": 0, "maximum": 5 },
          "riskSafetyScore": { "type": "integer", "minimum": 0, "maximum": 5 },
          "totalScore": { "type": "integer", "minimum": 0, "maximum": 100 }
        }
      }
    },
    "chosenOpportunity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["sourceAlternativeName", "workingProductName", "targetSegment", "consumerMoment", "instagramCreativeHook", "mobileValueMomentMinutes", "jobToBeDone", "promise", "chosenFormat", "experienceSteps", "commercialModelHypothesis", "acquisitionAngle", "firstTest", "economicBoundary", "ethicalBoundary", "benchmark"],
      "properties": {
        "sourceAlternativeName": { "type": "string" },
        "workingProductName": { "type": "string" },
        "targetSegment": { "type": "string" },
        "consumerMoment": { "type": "string" },
        "instagramCreativeHook": { "type": "string" },
        "mobileValueMomentMinutes": { "type": "integer", "minimum": 1, "maximum": 120 },
        "jobToBeDone": { "type": "string" },
        "promise": { "type": "string" },
        "chosenFormat": { "type": "string", "enum": ["STATIC_MATERIAL", "GUIDED_WEBAPP", "ASSISTED_EXECUTION"] },
        "experienceSteps": { "type": "array", "minItems": 3, "maxItems": 7, "items": { "type": "string" } },
        "commercialModelHypothesis": { "type": "string" },
        "acquisitionAngle": { "type": "string" },
        "firstTest": { "type": "string" },
        "economicBoundary": { "type": "string" },
        "ethicalBoundary": { "type": "string" },
        "benchmark": {
          "type": "object",
          "additionalProperties": false,
          "required": ["name", "score", "candidateScore", "result", "comparisonRationale"],
          "properties": {
            "name": { "type": "string" },
            "score": { "type": "integer", "minimum": 0, "maximum": 100 },
            "candidateScore": { "type": "integer", "minimum": 0, "maximum": 100 },
            "result": { "type": "string", "enum": ["EXCEEDS", "MEETS", "BELOW"] },
            "comparisonRationale": { "type": "string" }
          }
        }
      }
    },
    "rejectedReasons": { "type": "array", "items": { "type": "string" } },
    "missingEvidence": { "type": "array", "items": { "type": "string" } },
    "rationale": { "type": "string" }
  }
}
