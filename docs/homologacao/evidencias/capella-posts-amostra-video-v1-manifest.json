  "sample": "Uma peça demonstrativa com legenda, gratuita, sem promessa de personalização individual ou geração paga por pedido.",
  "segments": [
    {
      "scene": 0,
      "startSeconds": 0,
      "durationSeconds": 3.433333333333333,
      "speech": "Seu trabalho é caprichado. Sua divulgação mostra isso?"
    },
    {
      "scene": 1,
      "startSeconds": 3.433333333333333,
      "durationSeconds": 3.2333333333333334,
      "speech": "Veja posts com seu nome, suas cores e sua cidade."
    },
    {
      "scene": 2,
      "startSeconds": 6.666666666666666,
      "durationSeconds": 2.933333333333333,
      "speech": "Uma mensagem clara para conversar sobre horários."
    },
    {
      "scene": 3,
      "startSeconds": 9.6,
      "durationSeconds": 3.2,
      "speech": "Uma apresentação à altura do cuidado que você oferece."
    },
    {
      "scene": 4,
      "startSeconds": 12.8,
      "durationSeconds": 3.533333333333333,
      "speech": "Inspirações para divulgar e convidar ao próximo cuidado."
    },
    {
      "scene": 5,
      "startSeconds": 16.333333333333336,
      "durationSeconds": 3.1,
      "speech": "Combinando nome, serviço e identidade visual."
    },
    {
      "scene": 6,
      "startSeconds": 19.433333333333337,
      "durationSeconds": 2.533333333333333,
      "speech": "Sem começar do zero a cada publicação."
    },
    {
      "scene": 7,
      "startSeconds": 21.96666666666667,
      "durationSeconds": 5.266666666666667,
      "speech": "Você recebe arte, legenda, mensagens para WhatsApp e uma sequência para publicar."
    },
    {
      "scene": 8,
      "startSeconds": 27.233333333333334,
      "durationSeconds": 3.3,
      "speech": "Menos tempo criando. Mais confiança para divulgar."
    },
    {
      "scene": 9,
      "startSeconds": 30.533333333333335,
      "durationSeconds": 5.6,
      "speech": "Dez posts, dez stories, dez legendas, cinco mensagens e calendário de sete dias."
    },
    {
      "scene": 10,
      "startSeconds": 36.13333333333333,
      "durationSeconds": 4.266666666666667,
      "speech": "O kit completo custa sessenta e sete reais, em pagamento único."
    },
    {
      "scene": 11,
      "startSeconds": 40.4,
      "durationSeconds": 4.633333333333334,
      "speech": "Entrega em até três dias úteis após pagamento aprovado e briefing completo."
    },
    {
      "scene": 12,
      "startSeconds": 45.03333333333333,
      "durationSeconds": 4.9,
      "speech": "Quer conhecer o estilo? Peça uma amostra demonstrativa gratuita pelo e-mail na legenda."
    }
  ],
  "status": "CANDIDATE_NOT_CAMPAIGN_AUTHORIZATION"
