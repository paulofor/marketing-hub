{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "additionalProperties": false,
  "required": ["diagnosis", "alternatives", "proposedAssumptions", "evidenceQuality", "recommendation", "sources"],
  "properties": {
    "diagnosis": {"type": "string", "minLength": 20},
    "alternatives": {
      "type": "array", "minItems": 3, "maxItems": 3,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["name", "benefit", "risk", "effort", "fit"],
        "properties": {
          "name": {"type": "string"}, "benefit": {"type": "string"},
          "risk": {"type": "string"}, "effort": {"type": "string"}, "fit": {"type": "string"}
        }
      }
    },
    "proposedAssumptions": {
      "type": "object", "additionalProperties": false,
      "required": ["offerPriceBrl", "variableCostPerSaleBrl", "expectedMonthlyTraffic", "expectedConversionRatePercent", "expectedCacBrl", "expectedRefundRatePercent", "fixedOperationalCostBrl"],
      "properties": {
        "offerPriceBrl": {"type": ["number", "null"], "minimum": 0},
        "variableCostPerSaleBrl": {"type": ["number", "null"], "minimum": 0},
        "expectedMonthlyTraffic": {"type": ["integer", "null"], "minimum": 0},
        "expectedConversionRatePercent": {"type": ["number", "null"], "minimum": 0, "maximum": 100},
        "expectedCacBrl": {"type": ["number", "null"], "minimum": 0},
        "expectedRefundRatePercent": {"type": ["number", "null"], "minimum": 0, "maximum": 100},
        "fixedOperationalCostBrl": {"type": ["number", "null"], "minimum": 0}
      }
    },
    "evidenceQuality": {"type": "string", "enum": ["LOW", "MEDIUM", "HIGH"]},
    "recommendation": {"type": "string", "minLength": 20},
    "sources": {
      "type": "array", "minItems": 2,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["url", "title", "accessedAt", "sourceType", "finding"],
        "properties": {
          "url": {"type": "string"}, "title": {"type": "string"},
          "accessedAt": {"type": "string"}, "sourceType": {"type": "string"}, "finding": {"type": "string"}
        }
      }
    }
  }
}
