{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["diagnosis", "sources", "alternatives", "recommendation"],
  "properties": {
    "diagnosis": {"type": "object", "additionalProperties": false, "required": ["bottleneck", "evidence", "behavioralMechanism", "competingExplanations", "causalConfidence"], "properties": {"bottleneck": {"type": "string"}, "evidence": {"type": "array", "items": {"type": "string"}}, "behavioralMechanism": {"enum": ["FRICTION", "UNCERTAINTY", "PERCEIVED_RISK", "PROOF", "CHOICE_OVERLOAD", "DELAYED_REWARD", "REGRET_AVERSION", "TRUST", "PROMISE_FIT"]}, "competingExplanations": {"type": "array", "minItems": 1, "items": {"type": "string"}}, "causalConfidence": {"enum": ["LOW", "MEDIUM", "HIGH"]}}},
    "sources": {"type": "array", "items": {"type": "object", "additionalProperties": false, "required": ["url", "title", "accessedAt", "sourceType", "collectionMethod", "learning"], "properties": {"url": {"type": "string"}, "title": {"type": "string"}, "accessedAt": {"type": "string"}, "sourceType": {"enum": ["PRIMARY", "MARKETPLACE", "SEARCH_TREND", "SOCIAL_PUBLIC", "COMPETITOR", "ECONOMIC_REPORT", "OTHER"]}, "collectionMethod": {"enum": ["WEB_SEARCH", "PLAYWRIGHT", "PUBLIC_API"]}, "learning": {"type": "string"}}}},
    "alternatives": {"type": "array", "minItems": 3, "maxItems": 3, "items": {"type": "object", "additionalProperties": false, "required": ["name", "benefit", "risk", "effort", "fit"], "properties": {"name": {"type": "string"}, "benefit": {"type": "string"}, "risk": {"type": "string"}, "effort": {"enum": ["LOW", "MEDIUM", "HIGH"]}, "fit": {"type": "string"}}}},
    "recommendation": {"type": "object", "additionalProperties": false, "required": ["selectedAlternative", "causalHypothesis", "primaryMetric", "continueCriterion", "adjustCriterion", "stopCriterion", "requiresHumanApproval"], "properties": {"selectedAlternative": {"type": "string"}, "causalHypothesis": {"type": "string"}, "primaryMetric": {"type": "string"}, "continueCriterion": {"type": "string"}, "adjustCriterion": {"type": "string"}, "stopCriterion": {"type": "string"}, "requiresHumanApproval": {"type": "boolean", "const": true}}}
  }
}
