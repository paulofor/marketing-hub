{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["diagnosis", "marketIntelligence", "sources", "alternatives", "recommendation"],
  "properties": {
    "diagnosis": {"type": "object", "additionalProperties": false, "required": ["bottleneck", "evidence", "behavioralMechanism", "competingExplanations", "causalConfidence"], "properties": {"bottleneck": {"type": "string"}, "evidence": {"type": "array", "items": {"type": "string"}}, "behavioralMechanism": {"type": "string", "enum": ["FRICTION", "UNCERTAINTY", "PERCEIVED_RISK", "PROOF", "CHOICE_OVERLOAD", "DELAYED_REWARD", "REGRET_AVERSION", "TRUST", "PROMISE_FIT"]}, "competingExplanations": {"type": "array", "minItems": 1, "items": {"type": "string"}}, "causalConfidence": {"type": "string", "enum": ["LOW", "MEDIUM", "HIGH"]}}},
    "marketIntelligence": {"type": "object", "additionalProperties": false, "required": ["customerLanguage", "competitors", "marketGap", "insight", "evidenceSufficiency"], "properties": {"customerLanguage": {"type": "array", "minItems": 1, "items": {"type": "object", "additionalProperties": false, "required": ["literalPhrase", "observedContext", "sourceUrl"], "properties": {"literalPhrase": {"type": "string"}, "observedContext": {"type": "string"}, "sourceUrl": {"type": "string"}}}}, "competitors": {"type": "array", "minItems": 1, "items": {"type": "object", "additionalProperties": false, "required": ["name", "promise", "mechanism", "delivery", "visiblePrice", "cta", "channel", "proof", "customerEffort", "sourceUrl"], "properties": {"name": {"type": "string"}, "promise": {"type": "string"}, "mechanism": {"type": "string"}, "delivery": {"type": "string"}, "visiblePrice": {"type": ["string", "null"]}, "cta": {"type": "string"}, "channel": {"type": "string"}, "proof": {"type": "string"}, "customerEffort": {"type": "string"}, "sourceUrl": {"type": "string"}}}}, "marketGap": {"type": "string"}, "insight": {"type": "string"}, "evidenceSufficiency": {"type": "string", "enum": ["INSUFFICIENT", "EXPLORATORY", "SUFFICIENT_TO_TEST"]}}},
    "sources": {"type": "array", "minItems": 2, "items": {"type": "object", "additionalProperties": false, "required": ["url", "title", "accessedAt", "sourceType", "evidenceClass", "collectionMethod", "learning", "statementType"], "properties": {"url": {"type": "string"}, "title": {"type": "string"}, "accessedAt": {"type": "string"}, "sourceType": {"type": "string", "enum": ["PRIMARY", "MARKETPLACE", "SEARCH_TREND", "SOCIAL_PUBLIC", "CUSTOMER_VOICE", "COMPETITOR", "ECONOMIC_REPORT", "OTHER"]}, "evidenceClass": {"type": "string", "enum": ["CUSTOMER", "COMPETITOR", "DEMAND", "CHANNEL", "ECONOMICS", "INTERNAL_RESULT", "SCIENTIFIC"]}, "collectionMethod": {"type": "string", "enum": ["WEB_SEARCH", "PLAYWRIGHT", "PUBLIC_API"]}, "learning": {"type": "string"}, "statementType": {"type": "string", "enum": ["FACT", "INFERENCE", "HYPOTHESIS"]}}}},
    "alternatives": {"type": "array", "minItems": 3, "maxItems": 3, "items": {"type": "object", "additionalProperties": false, "required": ["name", "buyer", "verifiablePromise", "mechanism", "delivery", "channel", "mentalStage", "supportingEvidence", "benefit", "risk", "effort", "fit"], "properties": {"name": {"type": "string"}, "buyer": {"type": "string"}, "verifiablePromise": {"type": "string"}, "mechanism": {"type": "string"}, "delivery": {"type": "string"}, "channel": {"type": "string"}, "mentalStage": {"type": "string", "enum": ["UNFAMILIAR", "RELEVANT", "COMPREHENSIBLE", "PLAUSIBLE", "PERSONALLY_VALUABLE", "DESIRABLE", "PURCHASABLE"]}, "supportingEvidence": {"type": "array", "minItems": 2, "items": {"type": "string"}}, "benefit": {"type": "string"}, "risk": {"type": "string"}, "effort": {"type": "string", "enum": ["LOW", "MEDIUM", "HIGH"]}, "fit": {"type": "string"}}}},
    "recommendation": {"type": "object", "additionalProperties": false, "required": ["selectedAlternative", "positioning", "causalHypothesis", "primaryMetric", "continueCriterion", "adjustCriterion", "stopCriterion", "memoryOutcome", "requiresHumanApproval"], "properties": {"selectedAlternative": {"type": "string"}, "positioning": {"type": "object", "additionalProperties": false, "required": ["headline", "supportingMessage", "deliverableClaim", "expectationRisk"], "properties": {"headline": {"type": "string"}, "supportingMessage": {"type": "string"}, "deliverableClaim": {"type": "string"}, "expectationRisk": {"type": "string"}}}, "causalHypothesis": {"type": "string"}, "primaryMetric": {"type": "string"}, "continueCriterion": {"type": "string"}, "adjustCriterion": {"type": "string"}, "stopCriterion": {"type": "string"}, "memoryOutcome": {"type": "string"}, "requiresHumanApproval": {"type": "boolean", "const": true}}}
  }
}
