{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "activity",
    "decision",
    "selectedDossierId",
    "selectedOpportunityId",
    "alternatives",
    "selectedAlternative",
    "productIdentity",
    "marketStrategicContract",
    "assumptions",
    "requiredChanges",
    "rationale",
    "sources"
  ],
  "properties": {
    "activity": { "type": "string", "enum": ["marketStrategy"] },
    "decision": { "type": "string", "enum": ["APPROVE", "ADJUST", "REJECT"] },
    "selectedDossierId": { "type": ["integer", "null"] },
    "selectedOpportunityId": { "type": ["integer", "null"] },
    "alternatives": {
      "type": "array",
      "minItems": 3,
      "maxItems": 3,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "benefit", "risk", "effort", "fit"],
        "properties": {
          "name": { "type": "string" },
          "benefit": { "type": "string" },
          "risk": { "type": "string" },
          "effort": { "type": "string" },
          "fit": { "type": "string" }
        }
      }
    },
    "selectedAlternative": { "type": "string" },
    "productIdentity": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "contractVersion",
        "mode",
        "internalName",
        "productTypeCode",
        "productTypeInternalName",
        "classificationRationale"
      ],
      "properties": {
        "contractVersion": { "type": "string", "enum": ["PRODUCT_IDENTITY_V1"] },
        "mode": {
          "type": "string",
          "enum": ["CREATE", "PRESERVE", "NOT_APPLICABLE"]
        },
        "internalName": { "type": "string", "maxLength": 191 },
        "productTypeCode": { "type": "string", "maxLength": 64 },
        "productTypeInternalName": { "type": "string", "maxLength": 191 },
        "classificationRationale": { "type": "string" }
      }
    },
    "marketStrategicContract": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "contractVersion",
        "status",
        "segment",
        "buyer",
        "problem",
        "desiredOutcome",
        "behavioralDrivers",
        "competitorAlternatives",
        "competitiveGap",
        "positioning",
        "offerThesis",
        "valueMechanism",
        "included",
        "excluded",
        "causalHypothesis",
        "primaryMetric",
        "continueCriteria",
        "adjustCriteria",
        "stopCriteria",
        "evidenceReferences",
        "agentValidationPlan"
      ],
      "properties": {
        "contractVersion": { "type": "string", "enum": ["MARKET_STRATEGY_V4"] },
        "status": {
          "type": "string",
          "enum": ["READY_FOR_AGENT_VALIDATION", "INSUFFICIENT_EVIDENCE"]
        },
        "segment": { "type": "string" },
        "buyer": { "type": "string" },
        "problem": { "type": "string" },
        "desiredOutcome": { "type": "string" },
        "behavioralDrivers": { "type": "array", "items": { "type": "string" } },
        "competitorAlternatives": { "type": "array", "items": { "type": "string" } },
        "competitiveGap": { "type": "string" },
        "positioning": { "type": "string" },
        "offerThesis": { "type": "string" },
        "valueMechanism": { "type": "string" },
        "included": { "type": "array", "items": { "type": "string" } },
        "excluded": { "type": "array", "items": { "type": "string" } },
        "causalHypothesis": { "type": "string" },
        "primaryMetric": { "type": "string" },
        "continueCriteria": { "type": "string" },
        "adjustCriteria": { "type": "string" },
        "stopCriteria": { "type": "string" },
        "evidenceReferences": { "type": "array", "items": { "type": "string" } },
        "agentValidationPlan": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "contractVersion",
            "hypothesis",
            "prototypeObjective",
            "purchaseScene",
            "strongestFreeAlternative",
            "prototypeAdvantage",
            "customerValueDelivery",
            "trafficClass",
            "internalMarker",
            "requiredScenarios",
            "requiredDevices",
            "maxReadyResultSeconds",
            "humanEvidenceClaimed",
            "commercialEvidenceClaimed",
            "paymentEnabled",
            "publicationAuthorized",
            "campaignAuthorized",
            "mediaSpendAuthorizedBrl",
            "sourceMaxAgeDays",
            "continueCriteria",
            "adjustCriteria",
            "stopCriteria",
            "sourceRefreshRequired",
            "sourceRefreshAction",
            "publicationBoundary"
          ],
          "properties": {
            "contractVersion": { "type": "string", "const": "PDE_AGENT_VALIDATION_V1" },
            "hypothesis": { "type": "string" },
            "prototypeObjective": { "type": "string" },
            "purchaseScene": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "trigger",
                "deadline",
                "costOfError",
                "budgetEvidence",
                "failedAttempt",
                "currentPaidBehavior"
              ],
              "properties": {
                "trigger": { "type": "string" },
                "deadline": { "type": "string" },
                "costOfError": { "type": "string" },
                "budgetEvidence": { "type": "string" },
                "failedAttempt": { "type": "string" },
                "currentPaidBehavior": { "type": "string" }
              }
            },
            "strongestFreeAlternative": { "type": "string" },
            "prototypeAdvantage": { "type": "string" },
            "customerValueDelivery": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "territories",
                "desiredTransformation",
                "evidenceSourceIds",
                "evidencePathways",
                "readyMadeOutcome",
                "minimumCustomerInput",
                "requiresPromptEngineering",
                "requiresManualAssembly",
                "usableWithoutAiKnowledge",
                "customerStepsToValue",
                "timeToUsableResultMinutes",
                "automationBoundary"
              ],
              "properties": {
                "territories": {
                  "type": "array",
                  "minItems": 1,
                  "items": {
                    "type": "string",
                    "enum": [
                      "AFFECTION_AND_BELONGING",
                      "RECOGNITION",
                      "EFFORT_RELIEF"
                    ]
                  }
                },
                "desiredTransformation": { "type": "string" },
                "evidenceSourceIds": {
                  "type": "array",
                  "minItems": 2,
                  "items": { "type": "string" }
                },
                "evidencePathways": {
                  "type": "array",
                  "minItems": 2,
                  "items": { "type": "string" }
                },
                "readyMadeOutcome": { "type": "string" },
                "minimumCustomerInput": { "type": "string" },
                "requiresPromptEngineering": { "type": "boolean", "const": false },
                "requiresManualAssembly": { "type": "boolean", "const": false },
                "usableWithoutAiKnowledge": { "type": "boolean", "const": true },
                "customerStepsToValue": { "type": "integer", "minimum": 1, "maximum": 5 },
                "timeToUsableResultMinutes": {
                  "type": "integer",
                  "minimum": 1,
                  "maximum": 10
                },
                "automationBoundary": { "type": "string" }
              }
            },
            "trafficClass": { "type": "string", "const": "AGENT_VALIDATION" },
            "internalMarker": { "type": "string", "const": "mh_internal_test" },
            "requiredScenarios": {
              "type": "array",
              "minItems": 3,
              "maxItems": 3,
              "items": {
                "type": "string",
                "enum": ["ADHERENT", "RECOVERY", "SAFETY"]
              }
            },
            "requiredDevices": {
              "type": "array",
              "minItems": 3,
              "maxItems": 3,
              "items": {
                "type": "string",
                "enum": ["DESKTOP_1440", "IPHONE_15_PRO", "PIXEL_7"]
              }
            },
            "maxReadyResultSeconds": { "type": "integer", "const": 600 },
            "humanEvidenceClaimed": { "type": "boolean", "const": false },
            "commercialEvidenceClaimed": { "type": "boolean", "const": false },
            "paymentEnabled": { "type": "boolean", "const": false },
            "publicationAuthorized": { "type": "boolean", "const": false },
            "campaignAuthorized": { "type": "boolean", "const": false },
            "mediaSpendAuthorizedBrl": { "type": "number", "const": 0 },
            "sourceMaxAgeDays": { "type": "integer", "minimum": 1, "maximum": 90 },
            "continueCriteria": { "type": "string" },
            "adjustCriteria": { "type": "string" },
            "stopCriteria": { "type": "string" },
            "sourceRefreshRequired": { "type": "boolean" },
            "sourceRefreshAction": { "type": "string" },
            "publicationBoundary": { "type": "string" }
          }
        }
      }
    },
    "assumptions": { "type": "array", "items": { "type": "string" } },
    "requiredChanges": { "type": "array", "items": { "type": "string" } },
    "rationale": { "type": "string" },
    "sources": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["url", "title", "evidence"],
        "properties": {
          "url": { "type": "string" },
          "title": { "type": "string" },
          "evidence": { "type": "string" }
        }
      }
    }
  }
}
