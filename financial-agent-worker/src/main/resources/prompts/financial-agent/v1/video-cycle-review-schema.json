{
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "decision": {"type": "string", "enum": ["APPROVED", "REJECTED"]},
    "reason": {"type": "string", "minLength": 10},
    "recommendedAggregator": {"type": "string", "minLength": 2},
    "recommendedRoute": {
      "type": "string",
      "minLength": 2,
      "description": "Repita exatamente o batchRouteId persistido em providerPreflight.selectedRoutesJson."
    },
    "estimatedCostUsd": {"type": "number", "minimum": 0},
    "costBenefitBasis": {"type": "string", "minLength": 10},
    "creditAction": {"type": "string", "enum": ["NO_PURCHASE", "RECHARGE_REQUIRED", "BLOCKED_UNKNOWN"]},
    "recommendedRechargeCredits": {"type": ["number", "null"], "minimum": 0},
    "rechargeUrl": {"type": ["string", "null"]}
  },
  "required": [
    "decision",
    "reason",
    "recommendedAggregator",
    "recommendedRoute",
    "estimatedCostUsd",
    "costBenefitBasis",
    "creditAction",
    "recommendedRechargeCredits",
    "rechargeUrl"
  ]
}
