{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "decision",
    "decisionBasis",
    "costCoverageAssessment",
    "scenarios",
    "recommendedInitialInvestmentBrl",
    "recommendedCycleLimitBrl",
    "breakEven",
    "decisionCriteria",
    "limitations",
    "learningCandidate",
    "executiveSummary"
  ],
  "properties": {
    "decision": {
      "type": "string",
      "enum": ["APPROVE", "ADJUST", "BLOCKED"],
      "description": "APPROVE depende do escopo selecionado pelo contrato. ECONOMIC_VIABILITY exige rentabilidade e margem da política. LIMITED_DISCOVERY permite resultado BASE negativo e margem após CAC abaixo da meta somente com aceite estruturado válido, cobertura completa, entrega positiva antes do CAC e teto/prazo respeitados; não aprova continuidade, escala, publicação ou gasto. Lacuna essencial mantém BLOCKED e ajuste fora do risco aceito mantém ADJUST."
    },
    "decisionBasis": {
      "type": "string",
      "description": "Identifique o escopo e as fontes da decisão. Em descoberta limitada, preserve prejuízo e margem projetados, teto total, duração, meta de continuidade e demais gates; não converta perda aceita em rentabilidade."
    },
    "costCoverageAssessment": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "evidence", "missingCosts"],
      "properties": {
        "status": {
          "type": "string",
          "enum": ["COMPLETE_AGGREGATE", "COMPLETE_DETAILED", "INCOMPLETE"]
        },
        "evidence": { "type": "array", "items": { "type": "string" } },
        "missingCosts": { "type": "array", "items": { "type": "string" } }
      }
    },
    "scenarios": {
      "type": "array",
      "minItems": 3,
      "maxItems": 3,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "name",
          "assumptions",
          "traffic",
          "conversionRatePercent",
          "averagePriceBrl",
          "revenueBrl",
          "contributionMarginPercent",
          "profitBrl",
          "cacBrl",
          "roas"
        ],
        "properties": {
          "name": {
            "type": "string",
            "enum": ["CONSERVATIVE", "BASE", "OPTIMISTIC"]
          },
          "assumptions": { "type": "array", "items": { "type": "string" } },
          "traffic": { "type": ["integer", "null"] },
          "conversionRatePercent": { "type": ["number", "null"] },
          "averagePriceBrl": { "type": ["number", "null"] },
          "revenueBrl": { "type": ["number", "null"] },
          "contributionMarginPercent": { "type": ["number", "null"] },
          "profitBrl": { "type": ["number", "null"] },
          "cacBrl": { "type": ["number", "null"] },
          "roas": { "type": ["number", "null"] }
        }
      }
    },
    "recommendedInitialInvestmentBrl": { "type": ["number", "null"] },
    "recommendedCycleLimitBrl": { "type": ["number", "null"] },
    "breakEven": { "type": "string" },
    "decisionCriteria": {
      "type": "object",
      "additionalProperties": false,
      "required": ["continue", "adjust", "stop"],
      "properties": {
        "continue": { "type": "array", "items": { "type": "string" } },
        "adjust": { "type": "array", "items": { "type": "string" } },
        "stop": { "type": "array", "items": { "type": "string" } }
      }
    },
    "limitations": { "type": "array", "items": { "type": "string" } },
    "learningCandidate": { "type": ["string", "null"] },
    "executiveSummary": { "type": "string", "minLength": 30 }
  }
}
