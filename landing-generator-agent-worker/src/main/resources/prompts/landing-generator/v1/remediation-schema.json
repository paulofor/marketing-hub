    "generationApproachOptions":{"type":"array","minItems":3,"maxItems":6,"items":{"type":"object","additionalProperties":false,"required":["approachCode","available","benefit","risk","effort","offerFit","qualityEvidence","operationalEvidence","commercialEvidence"],"properties":{"approachCode":{"type":"string","enum":["GERALANDING_PIPELINE","COMPONENT_TEMPLATE_COMPOSER","CODEX_CODE_IMPLEMENTATION"]},"available":{"type":"boolean"},"benefit":{"type":"string","minLength":10,"maxLength":600},"risk":{"type":"string","minLength":10,"maxLength":600},"effort":{"type":"string","minLength":3,"maxLength":200},"offerFit":{"type":"string","minLength":10,"maxLength":600},"qualityEvidence":{"type":"string","minLength":10,"maxLength":800},"operationalEvidence":{"type":"string","minLength":10,"maxLength":800},"commercialEvidence":{"type":"string","minLength":10,"maxLength":800}}}},
    "selectedGenerationApproach":{"type":"object","additionalProperties":false,"required":["approachCode","justification","baseline","evaluationWindow","switchCriterion"],"properties":{"approachCode":{"type":"string","enum":["GERALANDING_PIPELINE","COMPONENT_TEMPLATE_COMPOSER","CODEX_CODE_IMPLEMENTATION"]},"justification":{"type":"string","minLength":20,"maxLength":1000},"baseline":{"type":"string","minLength":5,"maxLength":600},"evaluationWindow":{"type":"string","minLength":5,"maxLength":400},"switchCriterion":{"type":"string","minLength":10,"maxLength":600}}},
    "capabilityRecommendation":{"type":"object","additionalProperties":false,"required":["needed","approachCode","reason","evidenceRequired"],"properties":{"needed":{"type":"boolean"},"approachCode":{"type":["string","null"],"enum":["GERALANDING_PIPELINE","COMPONENT_TEMPLATE_COMPOSER","CODEX_CODE_IMPLEMENTATION",null]},"reason":{"type":"string","maxLength":1000},"evidenceRequired":{"type":"array","maxItems":8,"items":{"type":"string","minLength":10,"maxLength":500}}}},
    "strategyOptions":{"type":"array","minItems":3,"maxItems":5,"items":{"type":"object","additionalProperties":false,"required":["name","benefit","risk","effort","offerFit"],"properties":{"name":{"type":"string","minLength":5,"maxLength":120},"benefit":{"type":"string","minLength":10,"maxLength":600},"risk":{"type":"string","minLength":10,"maxLength":600},"effort":{"type":"string","minLength":3,"maxLength":200},"offerFit":{"type":"string","minLength":10,"maxLength":600}}}},
    "selectedStrategy":{"type":"object","additionalProperties":false,"required":["name","justification","commercialPromise","primaryCta"],"properties":{"name":{"type":"string","minLength":5,"maxLength":120},"justification":{"type":"string","minLength":20,"maxLength":1000},"commercialPromise":{"type":"string","minLength":10,"maxLength":500},"primaryCta":{"type":"string","minLength":3,"maxLength":160}}},
    "blockingIssues":{"type":"array","minItems":1,"maxItems":12,"items":{"type":"object","additionalProperties":false,"required":["code","rootCause","impact","requiredChange","evidence"],"properties":{"code":{"type":"string","minLength":3,"maxLength":80},"rootCause":{"type":"string","minLength":10,"maxLength":800},"impact":{"type":"string","minLength":10,"maxLength":500},"requiredChange":{"type":"string","minLength":10,"maxLength":1000},"evidence":{"type":"string","minLength":10,"maxLength":1000}}}},
    "recommendedRegeneration":{"type":"array","minItems":1,"maxItems":6,"items":{"type":"string","enum":["LANDING_PAGE_WIREFRAME","LANDING_PAGE_COPY","LANDING_PAGE_IMAGE_PLANNING","LANDING_PAGE_IMAGE_GENERATION","LANDING_PAGE_DESIGN_PRESET","LANDING_PAGE_HTML"]}},
    "autonomousBacklog":{"type":"array","minItems":1,"maxItems":20,"items":{"type":"object","additionalProperties":false,"required":["order","stage","action","evidence","acceptanceByDevice"],"properties":{"order":{"type":"integer","minimum":1,"maximum":20},"stage":{"type":"string","enum":["LANDING_PAGE_WIREFRAME","LANDING_PAGE_COPY","LANDING_PAGE_IMAGE_PLANNING","LANDING_PAGE_IMAGE_GENERATION","LANDING_PAGE_DESIGN_PRESET","LANDING_PAGE_HTML"]},"action":{"type":"string","minLength":10,"maxLength":1000},"evidence":{"type":"string","minLength":10,"maxLength":1000},"acceptanceByDevice":{"type":"array","minItems":3,"maxItems":6,"items":{"type":"string","minLength":10,"maxLength":500}}}}},
    "acceptanceCriteria":{"type":"array","minItems":1,"maxItems":20,"items":{"type":"string","minLength":10,"maxLength":500}},
    "expectedMetrics":{"type":"array","minItems":1,"maxItems":10,"items":{"type":"object","additionalProperties":false,"required":["metric","baseline","expectedDirection","evidenceSource"],"properties":{"metric":{"type":"string","minLength":3,"maxLength":120},"baseline":{"type":"string","minLength":1,"maxLength":200},"expectedDirection":{"type":"string","enum":["INCREASE","DECREASE","MAINTAIN","PASS"]},"evidenceSource":{"type":"string","minLength":5,"maxLength":400}}}},
    "stopConditions":{"type":"object","additionalProperties":false,"required":["continueWhen","adjustWhen","stopWhen"],"properties":{"continueWhen":{"type":"array","minItems":1,"maxItems":8,"items":{"type":"string","minLength":10,"maxLength":400}},"adjustWhen":{"type":"array","minItems":1,"maxItems":8,"items":{"type":"string","minLength":10,"maxLength":400}},"stopWhen":{"type":"array","minItems":1,"maxItems":8,"items":{"type":"string","minLength":10,"maxLength":400}}}},
    "imageRequirements":{"type":"array","maxItems":8,"items":{"type":"object","additionalProperties":false,"required":["slot","purpose","prompt","acceptanceCriteria"],"properties":{"slot":{"type":"string","minLength":2,"maxLength":80},"purpose":{"type":"string","minLength":10,"maxLength":500},"prompt":{"type":"string","minLength":20,"maxLength":2000},"acceptanceCriteria":{"type":"array","minItems":1,"maxItems":8,"items":{"type":"string","minLength":10,"maxLength":400}}}}},
    "referencePatternModels":{"type":"array","maxItems":8,"items":{"type":"object","additionalProperties":false,"required":["source","abstractPattern","applicability","nonCopyingEvidence"],"properties":{"source":{"type":"string","minLength":10,"maxLength":1000},"abstractPattern":{"type":"string","minLength":10,"maxLength":800},"applicability":{"type":"string","minLength":10,"maxLength":800},"nonCopyingEvidence":{"type":"string","minLength":10,"maxLength":500}}}},
    "learningHypotheses":{"type":"array","minItems":1,"maxItems":12,"items":{"type":"object","additionalProperties":false,"required":["hypothesis","baselineScore","expectedReward","confirmationSignals","contradictionSignals"],"properties":{"hypothesis":{"type":"string","minLength":10,"maxLength":1000},"baselineScore":{"type":"integer","minimum":0,"maximum":100},"expectedReward":{"type":"string","minLength":10,"maxLength":600},"confirmationSignals":{"type":"array","minItems":1,"maxItems":8,"items":{"type":"string","minLength":10,"maxLength":400}},"contradictionSignals":{"type":"array","minItems":1,"maxItems":8,"items":{"type":"string","minLength":10,"maxLength":400}}}}},
    "sources":{"type":"array","maxItems":12,"items":{"type":"string","maxLength":1000}}
