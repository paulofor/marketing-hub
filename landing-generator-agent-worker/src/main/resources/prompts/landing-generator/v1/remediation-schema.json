{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "type":"object",
  "additionalProperties":false,
  "required":["score","approvalRecommendation","summary","blockingIssues","recommendedRegeneration","acceptanceCriteria","imageRequirements","sources"],
  "properties":{
    "score":{"type":"integer","minimum":0,"maximum":100},
    "approvalRecommendation":{"type":"string","enum":["REGENERATE_BEFORE_PUBLICATION"]},
    "summary":{"type":"string","minLength":20,"maxLength":1500},
    "blockingIssues":{"type":"array","minItems":1,"maxItems":12,"items":{"type":"object","additionalProperties":false,"required":["code","rootCause","impact","requiredChange","evidence"],"properties":{"code":{"type":"string","minLength":3,"maxLength":80},"rootCause":{"type":"string","minLength":10,"maxLength":800},"impact":{"type":"string","minLength":10,"maxLength":500},"requiredChange":{"type":"string","minLength":10,"maxLength":1000},"evidence":{"type":"string","minLength":10,"maxLength":1000}}}},
    "recommendedRegeneration":{"type":"array","minItems":1,"maxItems":6,"uniqueItems":true,"items":{"type":"string","enum":["LANDING_PAGE_WIREFRAME","LANDING_PAGE_COPY","LANDING_PAGE_IMAGE_PLANNING","LANDING_PAGE_IMAGE_GENERATION","LANDING_PAGE_DESIGN_PRESET","LANDING_PAGE_HTML"]}},
    "acceptanceCriteria":{"type":"array","minItems":1,"maxItems":20,"items":{"type":"string","minLength":10,"maxLength":500}},
    "imageRequirements":{"type":"array","maxItems":8,"items":{"type":"object","additionalProperties":false,"required":["slot","purpose","prompt","acceptanceCriteria"],"properties":{"slot":{"type":"string","minLength":2,"maxLength":80},"purpose":{"type":"string","minLength":10,"maxLength":500},"prompt":{"type":"string","minLength":20,"maxLength":2000},"acceptanceCriteria":{"type":"array","minItems":1,"maxItems":8,"items":{"type":"string","minLength":10,"maxLength":400}}}}},
    "sources":{"type":"array","maxItems":12,"items":{"type":"string","maxLength":1000}}
  }
}
