{
  "type": "object",
  "additionalProperties": false,
  "required": ["decision", "rationale", "alternatives", "selectedApproach", "deliveryPackage", "acceptanceCriteria", "requiredChanges"],
  "properties": {
    "decision": {"type": "string", "enum": ["READY", "BLOCKED"]},
    "rationale": {"type": "string", "minLength": 20, "maxLength": 1200},
    "alternatives": {
      "type": "array", "minItems": 3, "maxItems": 3,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["name", "benefit", "risk", "effort", "salesFit"],
        "properties": {
          "name": {"type": "string", "minLength": 3, "maxLength": 120},
          "benefit": {"type": "string", "minLength": 10, "maxLength": 500},
          "risk": {"type": "string", "minLength": 10, "maxLength": 500},
          "effort": {"type": "string", "minLength": 3, "maxLength": 300},
          "salesFit": {"type": "string", "minLength": 10, "maxLength": 500}
        }
      }
    },
    "selectedApproach": {"type": "string", "minLength": 20, "maxLength": 500},
    "deliveryPackage": {
      "type": "object", "additionalProperties": false,
      "required": ["version", "assets", "responseLibrary", "qualificationQuestions", "followUps", "escalationRules", "briefingScript", "microDeliveryTemplate", "usageGuide", "updateChecklist", "customerManifest"],
      "properties": {
        "version": {"type": "string", "const": "kit-whatsapp-v1"},
        "assets": {
          "type": "array", "minItems": 6, "maxItems": 10,
          "items": {
            "type": "object", "additionalProperties": false,
            "required": ["code", "title", "format", "purpose", "contentMarkdown"],
            "properties": {
              "code": {"type": "string", "pattern": "^[a-z0-9-]+$"},
              "title": {"type": "string", "minLength": 3, "maxLength": 120},
              "format": {"type": "string", "enum": ["MARKDOWN", "CSV", "HTML"]},
              "purpose": {"type": "string", "minLength": 10, "maxLength": 400},
              "contentMarkdown": {"type": "string", "minLength": 50, "maxLength": 12000}
            }
          }
        },
        "responseLibrary": {
          "type": "array", "minItems": 10, "maxItems": 20,
          "items": {
            "type": "object", "additionalProperties": false,
            "required": ["scenario", "whenToUse", "messageTemplate", "personalizationFields", "doNotUseWhen", "humanReview"],
            "properties": {
              "scenario": {"type": "string", "minLength": 3, "maxLength": 120},
              "whenToUse": {"type": "string", "minLength": 10, "maxLength": 500},
              "messageTemplate": {"type": "string", "minLength": 20, "maxLength": 1200},
              "personalizationFields": {"type": "array", "minItems": 1, "maxItems": 8, "items": {"type": "string", "minLength": 2, "maxLength": 80}},
              "doNotUseWhen": {"type": "string", "minLength": 10, "maxLength": 500},
              "humanReview": {"type": "string", "minLength": 10, "maxLength": 500}
            }
          }
        },
        "qualificationQuestions": {"type": "array", "minItems": 5, "maxItems": 10, "items": {"type": "string", "minLength": 8, "maxLength": 300}},
        "followUps": {"type": "array", "minItems": 3, "maxItems": 5, "items": {"type": "string", "minLength": 20, "maxLength": 900}},
        "escalationRules": {"type": "array", "minItems": 5, "maxItems": 12, "items": {"type": "string", "minLength": 15, "maxLength": 700}},
        "briefingScript": {"type": "string", "minLength": 100, "maxLength": 7000},
        "microDeliveryTemplate": {"type": "string", "minLength": 100, "maxLength": 6000},
        "usageGuide": {"type": "string", "minLength": 100, "maxLength": 7000},
        "updateChecklist": {"type": "string", "minLength": 100, "maxLength": 5000},
        "customerManifest": {"type": "string", "minLength": 100, "maxLength": 3000}
      }
    },
    "acceptanceCriteria": {"type": "array", "minItems": 8, "maxItems": 18, "items": {"type": "string", "minLength": 10, "maxLength": 400}},
    "requiredChanges": {"type": "array", "maxItems": 12, "items": {"type": "string", "minLength": 5, "maxLength": 500}}
  }
}
