{
  "type": "object",
  "additionalProperties": false,
  "required": ["decision", "rationale", "alternatives", "selectedApproach", "deliveryPackage", "acceptanceCriteria", "requiredChanges"],
  "properties": {
    "decision": { "type": "string", "enum": ["READY", "BLOCKED"] },
    "rationale": { "type": "string", "minLength": 20, "maxLength": 1200 },
    "alternatives": {
      "type": "array",
      "minItems": 3,
      "maxItems": 3,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "benefit", "risk", "effort", "salesFit"],
        "properties": {
          "name": { "type": "string", "minLength": 3, "maxLength": 120 },
          "benefit": { "type": "string", "minLength": 10, "maxLength": 500 },
          "risk": { "type": "string", "minLength": 10, "maxLength": 500 },
          "effort": { "type": "string", "minLength": 3, "maxLength": 300 },
          "salesFit": { "type": "string", "minLength": 10, "maxLength": 500 }
        }
      }
    },
    "selectedApproach": { "type": "string", "minLength": 20, "maxLength": 500 },
    "deliveryPackage": {
      "type": "object",
      "additionalProperties": false,
      "required": ["version", "assets", "emptyStates", "errorStates", "demoData", "instrumentationEvents", "excludedScope"],
      "properties": {
        "version": { "type": "string", "const": "pde-private-prototype-v1" },
        "assets": {
          "type": "array",
          "minItems": 3,
          "maxItems": 8,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["code", "title", "format", "purpose", "contentContract", "inputBinding", "outputBinding"],
            "properties": {
              "code": { "type": "string", "pattern": "^[a-z0-9-]+$" },
              "title": { "type": "string", "minLength": 3, "maxLength": 120 },
              "format": { "type": "string", "enum": ["FORM", "GUIDED_FLOW", "RESULT_VIEW", "DOWNLOAD", "AUDIO", "VIDEO", "OTHER"] },
              "purpose": { "type": "string", "minLength": 10, "maxLength": 400 },
              "contentContract": { "type": "string", "minLength": 30, "maxLength": 6000 },
              "inputBinding": { "type": "string", "minLength": 5, "maxLength": 800 },
              "outputBinding": { "type": "string", "minLength": 5, "maxLength": 800 }
            }
          }
        },
        "emptyStates": { "type": "array", "minItems": 1, "maxItems": 8, "items": { "type": "string", "minLength": 10, "maxLength": 500 } },
        "errorStates": { "type": "array", "minItems": 2, "maxItems": 10, "items": { "type": "string", "minLength": 10, "maxLength": 500 } },
        "demoData": { "type": "string", "minLength": 20, "maxLength": 2000 },
        "instrumentationEvents": {
          "type": "array",
          "minItems": 5,
          "maxItems": 5,
          "items": { "type": "string", "enum": ["EXPERIENCE_STARTED", "VALUE_MOMENT", "READY_RESULT_USED", "PREFERRED_OVER_FREE", "CHECKOUT_STARTED"] }
        },
        "excludedScope": { "type": "array", "minItems": 3, "maxItems": 12, "items": { "type": "string", "minLength": 5, "maxLength": 300 } }
      }
    },
    "acceptanceCriteria": { "type": "array", "minItems": 6, "maxItems": 16, "items": { "type": "string", "minLength": 10, "maxLength": 400 } },
    "requiredChanges": { "type": "array", "maxItems": 12, "items": { "type": "string", "minLength": 5, "maxLength": 500 } }
  }
}
