{
  "type": "object",
  "additionalProperties": false,
  "required": ["decision", "rationale", "alternatives", "selectedApproach", "experienceContract", "acceptanceCriteria", "requiredChanges"],
  "properties": {
    "decision": { "type": "string", "enum": ["READY", "BLOCKED"] },
    "rationale": { "type": "string", "minLength": 20, "maxLength": 1200 },
    "alternatives": {
      "type": "array",
      "minItems": 3,
      "maxItems": 3,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "benefit", "risk", "effort", "salesFit"],
        "properties": {
          "name": { "type": "string", "minLength": 3, "maxLength": 120 },
          "benefit": { "type": "string", "minLength": 10, "maxLength": 500 },
          "risk": { "type": "string", "minLength": 10, "maxLength": 500 },
          "effort": { "type": "string", "minLength": 3, "maxLength": 300 },
          "salesFit": { "type": "string", "minLength": 10, "maxLength": 500 }
        }
      }
    },
    "selectedApproach": { "type": "string", "minLength": 20, "maxLength": 500 },
    "experienceContract": {
      "type": "object",
      "additionalProperties": false,
      "required": ["audienceMoment", "simpleInput", "stages", "readyResult", "maxValueTimeMinutes", "sensoryDirection", "aiHarness", "instrumentationEvents", "checkoutMode", "privacyBoundary"],
      "properties": {
        "audienceMoment": { "type": "string", "minLength": 20, "maxLength": 800 },
        "simpleInput": { "type": "string", "minLength": 10, "maxLength": 800 },
        "stages": {
          "type": "array",
          "minItems": 3,
          "maxItems": 6,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["id", "title", "objective", "customerAction", "systemResponse", "completionCriterion", "customerEffort"],
            "properties": {
              "id": { "type": "string", "pattern": "^[a-z0-9-]+$" },
              "title": { "type": "string", "minLength": 3, "maxLength": 120 },
              "objective": { "type": "string", "minLength": 10, "maxLength": 600 },
              "customerAction": { "type": "string", "minLength": 3, "maxLength": 600 },
              "systemResponse": { "type": "string", "minLength": 3, "maxLength": 600 },
              "completionCriterion": { "type": "string", "minLength": 10, "maxLength": 600 },
              "customerEffort": { "type": "string", "minLength": 3, "maxLength": 300 }
            }
          }
        },
        "readyResult": { "type": "string", "minLength": 20, "maxLength": 1000 },
        "maxValueTimeMinutes": { "type": "integer", "minimum": 1, "maximum": 10 },
        "sensoryDirection": { "type": "string", "minLength": 20, "maxLength": 1000 },
        "aiHarness": { "type": "string", "minLength": 20, "maxLength": 1200 },
        "instrumentationEvents": {
          "type": "array",
          "minItems": 5,
          "maxItems": 5,
          "items": { "type": "string", "enum": ["EXPERIENCE_STARTED", "VALUE_MOMENT", "READY_RESULT_USED", "PREFERRED_OVER_FREE", "CHECKOUT_STARTED"] }
        },
        "checkoutMode": { "type": "string", "const": "SIMULATED_NO_CHARGE" },
        "privacyBoundary": { "type": "string", "minLength": 20, "maxLength": 1000 }
      }
    },
    "acceptanceCriteria": { "type": "array", "minItems": 6, "maxItems": 16, "items": { "type": "string", "minLength": 10, "maxLength": 400 } },
    "requiredChanges": { "type": "array", "maxItems": 12, "items": { "type": "string", "minLength": 5, "maxLength": 500 } }
  }
}
