{
  "type": "object",
  "additionalProperties": false,
  "required": [
    "humanSummary",
    "decision",
    "rationale",
    "alternatives",
    "selectedApproach",
    "experienceContract",
    "acceptanceCriteria",
    "requiredChanges",
    "valueSpecification"
  ],
  "properties": {
    "humanSummary": {
      "type": "string",
      "minLength": 20,
      "maxLength": 420,
      "description": "Resumo em português simples: conclusão, motivo principal e próximo passo, em até três frases. Sem siglas, códigos ou detalhes técnicos; não inventar decisão do usuário."
    },
    "decision": {
      "type": "string",
      "enum": [
        "READY",
        "BLOCKED"
      ]
    },
    "rationale": {
      "type": "string",
      "minLength": 20,
      "maxLength": 1200
    },
    "alternatives": {
      "type": "array",
      "minItems": 3,
      "maxItems": 3,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "name",
          "benefit",
          "risk",
          "effort",
          "salesFit"
        ],
        "properties": {
          "name": {
            "type": "string",
            "minLength": 3,
            "maxLength": 120
          },
          "benefit": {
            "type": "string",
            "minLength": 10,
            "maxLength": 500
          },
          "risk": {
            "type": "string",
            "minLength": 10,
            "maxLength": 500
          },
          "effort": {
            "type": "string",
            "minLength": 3,
            "maxLength": 300
          },
          "salesFit": {
            "type": "string",
            "minLength": 10,
            "maxLength": 500
          }
        }
      }
    },
    "selectedApproach": {
      "type": "string",
      "minLength": 20,
      "maxLength": 500
    },
    "experienceContract": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "audienceMoment",
        "simpleInput",
        "stages",
        "readyResult",
        "maxValueTimeMinutes",
        "sensoryDirection",
        "aiHarness",
        "instrumentationEvents",
        "checkoutMode",
        "privacyBoundary"
      ],
      "properties": {
        "audienceMoment": {
          "type": "string",
          "minLength": 20,
          "maxLength": 800
        },
        "simpleInput": {
          "type": "string",
          "minLength": 10,
          "maxLength": 800
        },
        "stages": {
          "type": "array",
          "minItems": 3,
          "maxItems": 6,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "id",
              "title",
              "objective",
              "customerAction",
              "systemResponse",
              "completionCriterion",
              "customerEffort"
            ],
            "properties": {
              "id": {
                "type": "string",
                "pattern": "^[a-z0-9-]+$"
              },
              "title": {
                "type": "string",
                "minLength": 3,
                "maxLength": 120
              },
              "objective": {
                "type": "string",
                "minLength": 10,
                "maxLength": 600
              },
              "customerAction": {
                "type": "string",
                "minLength": 3,
                "maxLength": 600
              },
              "systemResponse": {
                "type": "string",
                "minLength": 3,
                "maxLength": 600
              },
              "completionCriterion": {
                "type": "string",
                "minLength": 10,
                "maxLength": 600
              },
              "customerEffort": {
                "type": "string",
                "minLength": 3,
                "maxLength": 300
              }
            }
          }
        },
        "readyResult": {
          "type": "string",
          "minLength": 20,
          "maxLength": 1000
        },
        "maxValueTimeMinutes": {
          "type": "integer",
          "minimum": 1,
          "maximum": 10
        },
        "sensoryDirection": {
          "type": "string",
          "minLength": 20,
          "maxLength": 1000
        },
        "aiHarness": {
          "type": "string",
          "minLength": 20,
          "maxLength": 1200
        },
        "instrumentationEvents": {
          "type": "array",
          "minItems": 5,
          "maxItems": 5,
          "items": {
            "type": "string",
            "enum": [
              "EXPERIENCE_STARTED",
              "VALUE_MOMENT",
              "READY_RESULT_USED",
              "PREFERRED_OVER_FREE",
              "CHECKOUT_STARTED"
            ]
          }
        },
        "checkoutMode": {
          "type": "string",
          "const": "SIMULATED_NO_CHARGE"
        },
        "privacyBoundary": {
          "type": "string",
          "minLength": 20,
          "maxLength": 1000
        }
      }
    },
    "acceptanceCriteria": {
      "type": "array",
      "minItems": 6,
      "maxItems": 16,
      "items": {
        "type": "string",
        "minLength": 10,
        "maxLength": 400
      }
    },
    "requiredChanges": {
      "type": "array",
      "maxItems": 12,
      "items": {
        "type": "string",
        "minLength": 5,
        "maxLength": 500
      }
    },
    "valueSpecification": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "contractVersion",
        "baselineSha256",
        "scope",
        "stories"
      ],
      "properties": {
        "contractVersion": {
          "type": "string",
          "const": "TURMALINA_VALUE_DELIVERY_V1"
        },
        "baselineSha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "scope": {
          "type": "string",
          "enum": [
            "PRODUCT",
            "PROTOTYPE_SLICE"
          ]
        },
        "stories": {
          "type": "array",
          "minItems": 1,
          "maxItems": 20,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "id",
              "sourceRefs",
              "customerOutcome",
              "action",
              "implementationNotes",
              "reuseEvidence",
              "deferReason",
              "screenStates",
              "criteria"
            ],
            "properties": {
              "id": {
                "type": "string",
                "minLength": 1
              },
              "sourceRefs": {
                "type": "array",
                "minItems": 1,
                "items": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "customerOutcome": {
                "type": "string",
                "minLength": 1
              },
              "action": {
                "type": "string",
                "enum": [
                  "BUILD",
                  "REUSE",
                  "DEFER"
                ]
              },
              "implementationNotes": {
                "type": "string",
                "minLength": 1
              },
              "reuseEvidence": {
                "type": "string"
              },
              "deferReason": {
                "type": "string"
              },
              "screenStates": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "entry",
                  "result",
                  "resume",
                  "empty",
                  "error"
                ],
                "properties": {
                  "entry": {
                    "type": "string",
                    "minLength": 1
                  },
                  "result": {
                    "type": "string",
                    "minLength": 1
                  },
                  "resume": {
                    "type": "string",
                    "minLength": 1
                  },
                  "empty": {
                    "type": "string",
                    "minLength": 1
                  },
                  "error": {
                    "type": "string",
                    "minLength": 1
                  }
                }
              },
              "criteria": {
                "type": "array",
                "minItems": 1,
                "items": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "id",
                    "given",
                    "when",
                    "then",
                    "testMethod"
                  ],
                  "properties": {
                    "id": {
                      "type": "string",
                      "minLength": 1
                    },
                    "given": {
                      "type": "string",
                      "minLength": 1
                    },
                    "when": {
                      "type": "string",
                      "minLength": 1
                    },
                    "then": {
                      "type": "string",
                      "minLength": 1
                    },
                    "testMethod": {
                      "type": "string",
                      "minLength": 1
                    }
                  }
                }
              }
            }
          }
        }
      }
    }
  }
}
