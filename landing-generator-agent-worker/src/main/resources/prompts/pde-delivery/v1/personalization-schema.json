{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["decision", "rationale", "alternatives", "selectedApproach", "personalizationPackage", "qualityChecks", "accessHandoff", "acceptanceCriteria", "requiredChanges"],
  "properties": {
    "decision": {"type": "string", "enum": ["READY", "BLOCKED"]},
    "rationale": {"type": "string", "minLength": 20, "maxLength": 1200},
    "alternatives": {
      "type": "array", "minItems": 3, "maxItems": 3,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["name", "benefit", "risk", "effort", "salesFit"],
        "properties": {
          "name": {"type": "string", "minLength": 3, "maxLength": 120},
          "benefit": {"type": "string", "minLength": 10, "maxLength": 500},
          "risk": {"type": "string", "minLength": 10, "maxLength": 500},
          "effort": {"type": "string", "minLength": 3, "maxLength": 300},
          "salesFit": {"type": "string", "minLength": 10, "maxLength": 500}
        }
      }
    },
    "selectedApproach": {"type": "string", "minLength": 20, "maxLength": 500},
    "personalizationPackage": {
      "type": "object", "additionalProperties": false,
      "required": ["contractReference", "productVersionReference", "customerInputReference", "scope", "deliverables", "exclusions", "humanReviewRequired"],
      "properties": {
        "contractReference": {"type": "string", "minLength": 3, "maxLength": 240},
        "productVersionReference": {"type": "string", "minLength": 3, "maxLength": 240},
        "customerInputReference": {"type": "string", "minLength": 3, "maxLength": 240},
        "scope": {"type": "string", "minLength": 20, "maxLength": 1200},
        "deliverables": {
          "type": "array", "minItems": 1, "maxItems": 24,
          "items": {
            "type": "object", "additionalProperties": false,
            "required": ["name", "format", "sourceInput", "content", "completionCriterion"],
            "properties": {
              "name": {"type": "string", "minLength": 3, "maxLength": 160},
              "format": {"type": "string", "minLength": 2, "maxLength": 80},
              "sourceInput": {"type": "string", "minLength": 3, "maxLength": 500},
              "content": {"type": "string", "minLength": 20, "maxLength": 12000},
              "completionCriterion": {"type": "string", "minLength": 10, "maxLength": 500}
            }
          }
        },
        "exclusions": {"type": "array", "minItems": 1, "maxItems": 12, "items": {"type": "string", "minLength": 5, "maxLength": 400}},
        "humanReviewRequired": {"type": "boolean"}
      }
    },
    "qualityChecks": {
      "type": "array", "minItems": 3, "maxItems": 16,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["check", "evidence", "status"],
        "properties": {
          "check": {"type": "string", "minLength": 5, "maxLength": 240},
          "evidence": {"type": "string", "minLength": 5, "maxLength": 800},
          "status": {"type": "string", "enum": ["PASS", "FAIL", "NOT_APPLICABLE"]}
        }
      }
    },
    "accessHandoff": {
      "type": "object", "additionalProperties": false,
      "required": ["deliveryChannel", "accessInstructions", "supportBoundary"],
      "properties": {
        "deliveryChannel": {"type": "string", "minLength": 3, "maxLength": 120},
        "accessInstructions": {"type": "string", "minLength": 20, "maxLength": 1000},
        "supportBoundary": {"type": "string", "minLength": 20, "maxLength": 800}
      }
    },
    "acceptanceCriteria": {"type": "array", "minItems": 5, "maxItems": 16, "items": {"type": "string", "minLength": 10, "maxLength": 400}},
    "requiredChanges": {"type": "array", "maxItems": 12, "items": {"type": "string", "minLength": 5, "maxLength": 500}}
  }
}
