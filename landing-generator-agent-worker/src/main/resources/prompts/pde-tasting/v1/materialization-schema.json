{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["decision", "rationale", "alternatives", "selectedApproach", "tastingExperience", "functionalArtifact", "instrumentationEvents", "testIsolation", "acceptanceCriteria", "requiredChanges"],
  "properties": {
    "decision": {"type": "string", "enum": ["READY", "BLOCKED"]},
    "rationale": {"type": "string", "minLength": 20, "maxLength": 1200},
    "alternatives": {
      "type": "array", "minItems": 3, "maxItems": 3,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["name", "benefit", "risk", "effort", "salesFit"],
        "properties": {
          "name": {"type": "string", "minLength": 3, "maxLength": 120},
          "benefit": {"type": "string", "minLength": 10, "maxLength": 500},
          "risk": {"type": "string", "minLength": 10, "maxLength": 500},
          "effort": {"type": "string", "minLength": 3, "maxLength": 300},
          "salesFit": {"type": "string", "minLength": 10, "maxLength": 500}
        }
      }
    },
    "selectedApproach": {"type": "string", "minLength": 20, "maxLength": 500},
    "tastingExperience": {
      "type": "object", "additionalProperties": false,
      "required": ["modality", "productVersionReference", "proofReference", "microValue", "paidBoundary", "steps", "expirationRule", "abusePrevention", "consentAndPrivacy", "continuationToPaid"],
      "properties": {
        "modality": {"type": "string", "minLength": 3, "maxLength": 120},
        "productVersionReference": {"type": "string", "minLength": 3, "maxLength": 240},
        "proofReference": {"type": "string", "minLength": 3, "maxLength": 240},
        "microValue": {"type": "string", "minLength": 20, "maxLength": 1000},
        "paidBoundary": {"type": "string", "minLength": 20, "maxLength": 1000},
        "steps": {
          "type": "array", "minItems": 3, "maxItems": 8,
          "items": {
            "type": "object", "additionalProperties": false,
            "required": ["order", "action", "input", "output", "completionCriterion"],
            "properties": {
              "order": {"type": "integer", "minimum": 1, "maximum": 8},
              "action": {"type": "string", "minLength": 10, "maxLength": 500},
              "input": {"type": "string", "minLength": 3, "maxLength": 500},
              "output": {"type": "string", "minLength": 3, "maxLength": 800},
              "completionCriterion": {"type": "string", "minLength": 10, "maxLength": 500}
            }
          }
        },
        "expirationRule": {"type": "string", "minLength": 10, "maxLength": 600},
        "abusePrevention": {"type": "string", "minLength": 10, "maxLength": 600},
        "consentAndPrivacy": {"type": "string", "minLength": 20, "maxLength": 800},
        "continuationToPaid": {"type": "string", "minLength": 20, "maxLength": 800}
      }
    },
    "functionalArtifact": {
      "type": "object", "additionalProperties": false,
      "required": ["type", "content", "limitations"],
      "properties": {
        "type": {"type": "string", "minLength": 3, "maxLength": 120},
        "content": {"type": "string", "minLength": 20, "maxLength": 12000},
        "limitations": {"type": "array", "minItems": 1, "maxItems": 12, "items": {"type": "string", "minLength": 5, "maxLength": 400}}
      }
    },
    "instrumentationEvents": {"type": "array", "minItems": 7, "maxItems": 12, "items": {"type": "string", "minLength": 3, "maxLength": 80}},
    "testIsolation": {"type": "string", "minLength": 20, "maxLength": 800},
    "acceptanceCriteria": {"type": "array", "minItems": 6, "maxItems": 16, "items": {"type": "string", "minLength": 10, "maxLength": 400}},
    "requiredChanges": {"type": "array", "maxItems": 12, "items": {"type": "string", "minLength": 5, "maxLength": 500}}
  }
}
