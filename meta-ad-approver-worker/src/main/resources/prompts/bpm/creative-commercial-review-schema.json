{
  "type": "object",
  "additionalProperties": false,
  "required": [
    "decision",
    "commercialRationale",
    "evidence",
    "requiredChanges",
    "renderedAssetAudit"
  ],
  "properties": {
    "decision": {
      "type": "string",
      "enum": [
        "APPROVED",
        "ADJUST",
        "BLOCKED"
      ]
    },
    "commercialRationale": {
      "type": "string",
      "minLength": 1
    },
    "evidence": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string"
      }
    },
    "requiredChanges": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "renderedAssetAudit": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "artifactId",
          "sha256",
          "assessment"
        ],
        "properties": {
          "artifactId": {
            "type": "integer",
            "minimum": 1
          },
          "sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "assessment": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    }
  }
}
