{
  "type": "object",
  "additionalProperties": false,
  "required": ["decision", "inspected", "qualityScore", "deliveryFidelityScore", "commercialReuseScore", "summary", "issues", "issueCodes"],
  "properties": {
    "decision": { "type": "string", "enum": ["APPROVED", "ADJUST"] },
    "inspected": { "type": "boolean" },
    "qualityScore": { "type": "integer", "minimum": 0, "maximum": 100 },
    "deliveryFidelityScore": { "type": "integer", "minimum": 0, "maximum": 100 },
    "commercialReuseScore": { "type": "integer", "minimum": 0, "maximum": 100 },
    "summary": { "type": "string", "minLength": 10 },
    "issues": {
      "type": "array",
      "items": { "type": "string", "minLength": 5 }
    },
    "issueCodes": {
      "type": "array",
      "maxItems": 8,
      "items": { "type": "string", "minLength": 3, "maxLength": 80 }
    }
  }
}
