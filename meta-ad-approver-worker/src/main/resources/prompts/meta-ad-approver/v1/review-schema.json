{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["decision", "attentionScore", "clarityScore", "desireScore", "credibilityScore", "actionScore", "copyAssessment", "commercialAestheticAssessment", "destinationIntegrationAssessment", "summary", "issues", "recommendations", "revisedHeadline", "revisedPrimaryText", "revisedDescription", "revisedCta", "revisedImagePrompt", "mandatoryVisualRequirements", "forbiddenVisualElements", "visualAcceptanceCriteria", "correctionTargets"],
  "anyOf": [
    {
      "properties": {
        "decision": {"const": "APPROVED"},
        "correctionTargets": {"maxItems": 0}
      },
      "required": ["decision", "correctionTargets"]
    },
    {
      "properties": {
        "decision": {"enum": ["ADJUST", "REJECTED"]},
        "correctionTargets": {"minItems": 1}
      },
      "required": ["decision", "correctionTargets"]
    }
  ],
  "properties": {
    "decision": {"type": "string", "enum": ["APPROVED", "ADJUST", "REJECTED"]},
    "attentionScore": {"type": "integer", "minimum": 0, "maximum": 100},
    "clarityScore": {"type": "integer", "minimum": 0, "maximum": 100},
    "desireScore": {"type": "integer", "minimum": 0, "maximum": 100},
    "credibilityScore": {"type": "integer", "minimum": 0, "maximum": 100},
    "actionScore": {"type": "integer", "minimum": 0, "maximum": 100},
    "copyAssessment": {"type": "string", "minLength": 10},
    "commercialAestheticAssessment": {"type": "string", "minLength": 10},
    "destinationIntegrationAssessment": {"type": "string", "minLength": 10},
    "summary": {"type": "string", "minLength": 10},
    "issues": {"type": "array", "items": {"type": "string"}},
    "recommendations": {"type": "array", "items": {"type": "string"}},
    "revisedHeadline": {"type": "string", "maxLength": 40},
    "revisedPrimaryText": {"type": "string", "maxLength": 125},
    "revisedDescription": {"type": "string", "maxLength": 25},
    "revisedCta": {"type": "string"},
    "revisedImagePrompt": {"type": "string"},
    "mandatoryVisualRequirements": {"type": "array", "items": {"type": "string"}},
    "forbiddenVisualElements": {"type": "array", "items": {"type": "string"}},
    "visualAcceptanceCriteria": {"type": "array", "items": {"type": "string"}},
    "correctionTargets": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["target", "issueCode", "requirement", "acceptanceCriterion"],
        "properties": {
          "target": {"type": "string", "enum": ["CREATIVE_COPY", "CREATIVE_MEDIA", "LANDING"]},
          "issueCode": {"type": "string", "minLength": 3},
          "requirement": {"type": "string", "minLength": 10},
          "acceptanceCriterion": {"type": "string", "minLength": 10}
        }
      }
    }
  }
}
