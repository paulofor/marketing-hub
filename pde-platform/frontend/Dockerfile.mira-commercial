FROM node:20-alpine AS build
WORKDIR /app
COPY package.json package-lock.json* ./
RUN npm ci --include=dev --no-audit --no-fund
RUN apk add --no-cache bash ffmpeg
COPY . .
RUN node scripts/source-fingerprint.mjs > /app/frontend-source.sha256 \
    && npm run build:mira-commercial \
    && mv dist-mira-commercial/mira-commercial.html dist-mira-commercial/index.html

FROM nginx:1.27-alpine
ARG PDE_FRONTEND_VERSION_ID=mira-commercial-v1
COPY --from=build /app/dist-mira-commercial /usr/share/nginx/html
COPY --from=build /app/frontend-source.sha256 /usr/share/nginx/html/frontend-source.sha256
COPY nginx.mira-commercial.conf /etc/nginx/templates/default.conf.template
COPY docker-entrypoint-mira-commercial.d/ /docker-entrypoint.d/
ENV PDE_BACKEND_UPSTREAM=pde-platform-backend:8096
ENV PDE_FRONTEND_VERSION_ID=${PDE_FRONTEND_VERSION_ID}
RUN chmod +x /docker-entrypoint.d/10-runtime-config.sh \
    && printf '{"versionId":"%s"}\n' "${PDE_FRONTEND_VERSION_ID}" > /usr/share/nginx/html/pde-image-version.json
EXPOSE 80
