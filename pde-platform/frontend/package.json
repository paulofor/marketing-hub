{
  "name": "pde-platform-frontend",
  "version": "0.0.1",
  "private": true,
  "scripts": {
    "check:api-boundary": "bash scripts/validate-api-boundary.sh",
    "dev": "NODE_ENV=development vite --host 0.0.0.0",
    "generate:musa-diagnostic-assets": "node scripts/generate-musa-diagnostic-assets.mjs",
    "check:no-musa-slide-videos": "node scripts/validate-no-musa-slide-videos.mjs",
    "prebuild": "npm run check:no-musa-slide-videos",
    "build": "tsc --noEmit && vite build",
    "test:local-integration": "playwright test tests/musa-local-integration.spec.ts --config=playwright.local-integration.config.ts",
    "test:assisted-service": "playwright test tests/assisted-service-local.spec.ts --config=playwright.assisted-service.config.ts",
    "test:assisted-service:container": "playwright test tests/assisted-service-local.spec.ts --config=playwright.assisted-service.container.config.ts",
    "test:assisted-service:public-analytics": "playwright test tests/assisted-service-public-analytics.spec.ts --config=playwright.assisted-service-public-analytics.config.ts",
    "test:consultant-sdk": "playwright test tests/consultant-sdk-v1.visual.spec.ts --config=playwright.consultant-sdk.config.ts",
    "test:public-diagnostic-smoke": "playwright test tests/public-presence-diagnostic.smoke.spec.ts --config=playwright.public-api.config.ts",
    "test:public-health": "playwright test tests/public-health.spec.ts --config=playwright.public.config.ts",
    "test:visual": "playwright test",
    "preview": "vite preview --host 0.0.0.0"
  },
  "dependencies": {
    "@vitejs/plugin-react": "^6.0.3",
    "hls.js": "^1.6.16",
    "lucide-react": "^0.468.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "vite": "^8.1.4"
  },
  "devDependencies": {
    "@playwright/test": "^1.61.1",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "typescript": "^5.9.3"
  }
}
