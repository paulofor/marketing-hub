{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "scopeFingerprint",
    "status",
    "collectionName",
    "coherenceRationale",
    "items",
    "unknowns"
  ],
  "properties": {
    "schemaVersion": {
      "type": "string",
      "enum": [
        "manufacturing-conception-v1"
      ]
    },
    "scopeFingerprint": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "status": {
      "type": "string",
      "enum": [
        "CONCEPT_ONLY"
      ]
    },
    "collectionName": {
      "type": "string",
      "minLength": 1,
      "maxLength": 160
    },
    "coherenceRationale": {
      "type": "string",
      "minLength": 1,
      "maxLength": 2000
    },
    "items": {
      "type": "array",
      "minItems": 1,
      "maxItems": 16,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "sku",
          "visualIntent",
          "useAdaptation"
        ],
        "properties": {
          "sku": {
            "type": "string",
            "minLength": 1,
            "maxLength": 191
          },
          "visualIntent": {
            "type": "string",
            "minLength": 1,
            "maxLength": 2000
          },
          "useAdaptation": {
            "type": "string",
            "minLength": 1,
            "maxLength": 2000
          }
        }
      }
    },
    "unknowns": {
      "type": "array",
      "maxItems": 30,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 500
      }
    }
  }
}
