FROM nginx:1.27-alpine

ARG RELEASE_MARKER
RUN printf '%s\n' "${RELEASE_MARKER}" > /usr/share/nginx/html/release-marker

COPY backend-nginx.conf /etc/nginx/conf.d/default.conf
COPY backend-entrypoint.sh /docker-entrypoint.d/10-fixture-runtime.sh
RUN chmod +x /docker-entrypoint.d/10-fixture-runtime.sh
