{
  "type": "object",
  "additionalProperties": false,
  "required": [
    "researchLens",
    "expansionAxis",
    "expansionRationale",
    "questions",
    "publicQueries",
    "marketplaceRequests",
    "metaAdRequests",
    "minimumComparableOffers",
    "stopConditions"
  ],
  "properties": {
    "researchLens": {
      "type": "string",
      "minLength": 8,
      "maxLength": 160
    },
    "expansionAxis": {
      "type": "string",
      "enum": [
        "INITIAL_SCOPE",
        "ADJACENT_LIFE_MOMENT",
        "ADJACENT_PAIN_LANGUAGE",
        "ADJACENT_PAID_ALTERNATIVE",
        "ADJACENT_AUDIENCE_CONTEXT"
      ]
    },
    "expansionRationale": {
      "type": "string",
      "minLength": 12,
      "maxLength": 500
    },
    "questions": {
      "type": "array",
      "minItems": 3,
      "items": { "type": "string" }
    },
    "publicQueries": {
      "type": "array",
      "minItems": 8,
      "maxItems": 24,
      "items": { "type": "string", "maxLength": 180 }
    },
    "marketplaceRequests": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["marketplace", "query", "maxProducts"],
        "properties": {
          "marketplace": {
            "type": "string",
            "enum": ["HOTMART", "CLICKBANK"]
          },
          "query": { "type": "string", "maxLength": 100 },
          "maxProducts": { "type": "integer", "minimum": 1, "maximum": 25 }
        }
      }
    },
    "metaAdRequests": {
      "type": "array",
      "minItems": 1,
      "maxItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["query", "country", "publisherPlatform", "maxAds"],
        "properties": {
          "query": { "type": "string", "maxLength": 60 },
          "country": { "type": "string", "minLength": 2, "maxLength": 2 },
          "publisherPlatform": {
            "type": "string",
            "enum": ["INSTAGRAM"]
          },
          "maxAds": { "type": "integer", "minimum": 1, "maximum": 50 }
        }
      }
    },
    "minimumComparableOffers": { "type": "integer", "minimum": 10 },
    "stopConditions": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string" }
    },
    "candidateGaps": {
      "type": "array",
      "minItems": 1,
      "maxItems": 3,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "candidateName",
          "pendingQuestion",
          "appropriateSource",
          "evidenceNeeded",
          "contraryEvidenceToSeek",
          "publicQueries",
          "maxPublicQueries",
          "maxEstimatedSearchCostUsd"
        ],
        "properties": {
          "candidateName": { "type": "string", "maxLength": 191 },
          "pendingQuestion": { "type": "string", "maxLength": 700 },
          "appropriateSource": { "type": "string", "maxLength": 700 },
          "evidenceNeeded": { "type": "string", "maxLength": 700 },
          "contraryEvidenceToSeek": { "type": "string", "maxLength": 700 },
          "publicQueries": {
            "type": "array",
            "minItems": 1,
            "maxItems": 4,
            "items": { "type": "string", "maxLength": 180 }
          },
          "maxPublicQueries": { "type": "integer", "minimum": 1, "maximum": 4 },
          "maxEstimatedSearchCostUsd": {
            "type": "number",
            "minimum": 0,
            "maximum": 0.06
          }
        }
      }
    },
    "researchLimits": {
      "type": "object",
      "additionalProperties": false,
      "required": ["maxPublicQueries", "maxEstimatedSearchCostUsd"],
      "properties": {
        "maxPublicQueries": { "type": "integer", "minimum": 1, "maximum": 12 },
        "maxEstimatedSearchCostUsd": {
          "type": "number",
          "minimum": 0,
          "maximum": 0.06
        }
      }
    }
  }
}
