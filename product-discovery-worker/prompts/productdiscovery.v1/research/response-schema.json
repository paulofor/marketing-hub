          "name",
          "primaryAudience",
          "purchaseSituation",
          "rootPain",
          "practicalPain",
          "emotionalPain",
          "observedLanguage",
          "currentAlternatives",
          "residualEffort",
          "scaleEvidence",
          "unmetnessEvidence",
          "pdeValueBoundary",
          "instagramFitEvidence",
          "commercialRisk",
          "evidenceIds",
          "maturity"
        ],
        "properties": {
          "name": { "type": "string" },
          "primaryAudience": { "type": "string" },
          "purchaseSituation": { "type": "string" },
          "rootPain": { "type": "string" },
          "practicalPain": { "type": "string" },
          "emotionalPain": { "type": "string" },
          "observedLanguage": {
            "type": "array",
            "minItems": 1,
            "items": { "type": "string" }
          },
          "currentAlternatives": {
            "type": "array",
            "minItems": 1,
            "items": { "type": "string" }
          },
          "residualEffort": { "type": "string" },
          "scaleEvidence": { "type": "string" },
