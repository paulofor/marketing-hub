{
  "type": "object",
  "additionalProperties": false,
  "required": ["decisionSummary", "candidates"],
  "properties": {
    "decisionSummary": { "type": "string", "maxLength": 1500 },
    "candidates": {
      "type": "array",
      "minItems": 2,
      "maxItems": 3,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "name",
          "primaryAudience",
          "purchaseSituation",
          "rootPain",
          "practicalPain",
          "emotionalPain",
          "observedLanguage",
          "currentAlternatives",
          "residualEffort",
          "scaleEvidence",
          "unmetnessEvidence",
          "pdeValueBoundary",
          "pdeDeliveryFit",
          "instagramFitEvidence",
          "commercialRisk",
          "evidenceIds",
          "maturity"
        ],
        "properties": {
          "name": { "type": "string", "maxLength": 191 },
          "primaryAudience": { "type": "string", "maxLength": 191 },
          "purchaseSituation": { "type": "string", "maxLength": 900 },
          "rootPain": { "type": "string", "maxLength": 900 },
          "practicalPain": { "type": "string", "maxLength": 900 },
          "emotionalPain": { "type": "string", "maxLength": 900 },
          "observedLanguage": {
            "type": "array",
            "minItems": 1,
            "maxItems": 8,
            "items": { "type": "string", "maxLength": 500 }
          },
          "currentAlternatives": {
            "type": "array",
            "minItems": 1,
            "maxItems": 8,
            "items": { "type": "string", "maxLength": 500 }
          },
          "residualEffort": { "type": "string", "maxLength": 900 },
          "scaleEvidence": { "type": "string", "maxLength": 1000 },
          "unmetnessEvidence": { "type": "string", "maxLength": 1000 },
          "pdeValueBoundary": { "type": "string", "maxLength": 1000 },
          "pdeDeliveryFit": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "deliveryMode",
              "minimumInput",
              "aiBackstageWork",
              "readyDigitalOutcome",
              "physicalDependency"
            ],
            "properties": {
              "deliveryMode": {
                "type": "string",
                "enum": ["AI_DIGITAL_EXPERIENCE"]
              },
              "minimumInput": { "type": "string", "maxLength": 700 },
              "aiBackstageWork": { "type": "string", "maxLength": 900 },
              "readyDigitalOutcome": { "type": "string", "maxLength": 900 },
              "physicalDependency": {
                "type": "string",
                "enum": ["NONE"]
              }
            }
          },
          "instagramFitEvidence": { "type": "string", "maxLength": 900 },
          "commercialRisk": { "type": "string", "maxLength": 1200 },
          "evidenceIds": {
            "type": "array",
            "minItems": 2,
            "maxItems": 32,
            "items": { "type": "string", "maxLength": 64 }
          },
          "maturity": {
            "type": "string",
            "enum": [
              "SIGNAL",
              "RESEARCHABLE",
              "DOSSIER_READY",
              "HUMAN_REVIEW",
              "REJECTED"
            ]
          }
        }
      }
    }
  }
}
