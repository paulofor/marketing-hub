{
  "type": "object",
  "required": ["decisionSummary", "opportunities"],
  "properties": {
    "decisionSummary": { "type": "string" },
    "opportunities": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["name", "primaryAudience", "rootPain", "humanValueTerritories", "humanValueEvidence", "readyMadeDeliverable", "minimumCustomerInput", "requiresPromptEngineering", "requiresManualAssembly", "usableWithoutAiKnowledge", "customerStepsToValue", "score", "decision"],
        "properties": {
          "name": { "type": "string" },
          "primaryAudience": { "type": "string" },
          "rootPain": { "type": "string" },
          "humanValueTerritories": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "enum": ["AFFECTION_AND_BELONGING", "RECOGNITION", "EFFORT_RELIEF"]
            }
          },
          "humanValueEvidence": { "type": "string" },
          "readyMadeDeliverable": { "type": "string" },
          "minimumCustomerInput": { "type": "string" },
          "requiresPromptEngineering": { "type": "boolean" },
          "requiresManualAssembly": { "type": "boolean" },
          "usableWithoutAiKnowledge": { "type": "boolean" },
          "customerStepsToValue": { "type": "integer", "minimum": 1, "maximum": 5 },
          "practicalPain": { "type": "string" },
          "emotionalPain": { "type": "string" },
          "scaleEvidence": { "type": "string" },
          "unmetnessEvidence": { "type": "string" },
          "pdeExperience": { "type": "string" },
          "firstCampaignAngle": { "type": "string" },
          "commercialRisk": { "type": "string" },
          "evidenceJson": { "type": "string" },
          "score": { "type": "number" },
          "decision": {
            "type": "string",
            "enum": ["APPROVE", "RESEARCH_MORE", "REJECT", "HUMAN_REVIEW"]
          }
        }
      }
    }
  }
}
