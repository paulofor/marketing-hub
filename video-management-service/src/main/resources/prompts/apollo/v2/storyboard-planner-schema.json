        "properties": {
          "order": {"type": "integer", "minimum": 1},
          "durationSeconds": {"type": "integer", "minimum": 1},
          "commercialRole": {"type": "string", "enum": ["HOOK_DOR", "RESULTADO", "MECANISMO", "PROVA", "CTA"]},
          "visualObjective": {"type": "string", "minLength": 12},
          "reuseExistingMaterial": {"type": "boolean"},
          "postProductionText": {"type": "string"}
        }
      }
    }
  }
}
